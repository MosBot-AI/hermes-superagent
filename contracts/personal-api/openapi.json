{
  "openapi": "3.1.0",
  "info": {
    "title": "Personal Agent shared client API",
    "version": "0.1.0",
    "description": "Experimental common wire contract. Not proof of live endpoints or native app authentication. Existing platform-native APIs are not aliases."
  },
  "servers": [
    {
      "url": "{baseUrl}",
      "variables": {
        "baseUrl": {
          "default": "/v1",
          "description": "Configured complete shared API base, including deployment/plugin mount prefix. Do not concatenate a root-relative /v1 onto it."
        }
      }
    }
  ],
  "paths": {
    "/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "description": "Proposed shared interface; the adapter capability manifest determines availability. Authentication and domain authorization remain server-side.",
        "responses": {
          "200": {
            "description": "Authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Capabilities"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Error"
                }
              }
            }
          },
          "409": {
            "description": "Capability unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "operationId": "listTasks",
        "description": "Proposed shared interface; the adapter capability manifest determines availability. Authentication and domain authorization remain server-side.",
        "responses": {
          "200": {
            "description": "Authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/TasksPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Error"
                }
              }
            }
          },
          "409": {
            "description": "Capability unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 32
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "backendSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-dshpa-mobile",
        "description": "Existing DSH native mobile session cookie, managed by the browser cookie jar after native pairing. This documents the only HTTP adapter implemented by the first slice, not a new issuer or Hermes cookie contract. Hermes domain HTTP is unavailable; a supported native authentication binding must be specified before enabling it. Native-app bearer login is not implemented by this contract."
      }
    }
  },
  "security": [
    {
      "backendSession": []
    }
  ]
}
