{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosbot:personal-api:0.1.0",
  "title": "Personal Agent client API 0.1.0",
  "$defs": {
    "Capability": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "tasks.list",
            "approvals.read",
            "approvals.respond",
            "changes.poll",
            "conversations.resume",
            "memory.read",
            "memory.write"
          ]
        },
        "supported": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            null,
            "not_implemented",
            "identity_unavailable",
            "disabled",
            "permission_denied"
          ]
        },
        "remediation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "operator_action",
                    "reauthenticate"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "kind",
                "message"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "supported",
        "enabled",
        "available",
        "reason",
        "remediation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "supported": {
                "const": true
              },
              "enabled": {
                "const": true
              },
              "reason": {
                "type": "null"
              },
              "remediation": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "supported": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "personal.api.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "contract_version": {
              "const": "0.1.0"
            },
            "backend": {
              "type": "object",
              "properties": {
                "id": {
                  "enum": [
                    "hermes",
                    "dsh"
                  ]
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false
            },
            "capabilities": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "$ref": "#/$defs/Capability"
              },
              "allOf": [
                {
                  "contains": {
                    "properties": {
                      "id": {
                        "const": "tasks.list"
                      }
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "id": {
                        "const": "approvals.read"
                      }
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "id": {
                        "const": "approvals.respond"
                      }
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "id": {
                        "const": "changes.poll"
                      }
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "id": {
                        "const": "conversations.resume"
                      }
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "id": {
                        "const": "memory.read"
                      }
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "id": {
                        "const": "memory.write"
                      }
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            },
            "transport": {
              "type": "object",
              "properties": {
                "polling": {
                  "type": "boolean"
                },
                "sse": {
                  "type": "boolean"
                }
              },
              "required": [
                "polling",
                "sse"
              ],
              "additionalProperties": false
            },
            "limits": {
              "type": "object",
              "properties": {
                "max_page_size": {
                  "const": 64
                }
              },
              "required": [
                "max_page_size"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "contract_version",
            "backend",
            "capabilities",
            "transport",
            "limits"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "data"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "personal.api.v1"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "auth_required",
                "invalid_request",
                "cursor_invalid",
                "capability_unavailable",
                "forbidden",
                "internal_unavailable"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "retryable": {
              "type": "boolean"
            },
            "capability": {
              "enum": [
                "tasks.list",
                "approvals.read",
                "approvals.respond",
                "changes.poll",
                "conversations.resume",
                "memory.read",
                "memory.write"
              ]
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "error"
      ],
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "title": {
          "type": "string",
          "maxLength": 4096
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "waiting",
            "paused",
            "completed",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "wait_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "revision",
        "state",
        "wait_reason"
      ],
      "additionalProperties": false
    },
    "TasksPage": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "personal.api.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/Task"
              }
            },
            "next_cursor": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              ]
            },
            "consistency": {
              "const": "live"
            }
          },
          "required": [
            "items",
            "next_cursor",
            "consistency"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
