+// An SSH connection's logical id survives edits. Bind recovery to the effective
+// target profile and the configured endpoint as well as the session key.
+export function legacyDraftRoute(owner: SessionOwnerScope, connections: DesktopRegistryConnection[]) {
+  if (!isSessionOwnerRoute(owner) || !owner.profile) { return undefined }
+  const source = connections.find(connection => connection.id === owner.connectionId)
+
+  return source?.kind === 'ssh' && source.host && source.user
+    ? JSON.stringify([
+      owner.connectionId, owner.profile, owner.targetProfile ?? owner.profile, source.host, source.user,
+      source.port ?? 22, source.keyPath ?? '', source.remoteHermesPath ?? '', source.remoteProfile ?? ''
+    ])
+    : undefined
+}
+
+export async function legacyDraftRouteDigest(route: string | undefined) {
+  if (!route) { return undefined }
+  const bytes = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(route))
+
+  return Array.from(new Uint8Array(bytes), byte => byte.toString(16).padStart(2, '0')).join('')
+}
+
+export async function listPreparedLegacyDrafts(target: string, scopeKey: string, route: string) {
+  // Only Electron's acknowledged journal has process-crash durability.
+  if (!window.hermesDesktop?.preparedSubmissions) { return [] }
+  const digest = await legacyDraftRouteDigest(route)
+  if (!digest) { return [] }
+
+  return Object.entries(await readJournal()).flatMap(([key, entry]) => {
+    const intent: unknown = JSON.parse(key)
+    if (!Array.isArray(intent)) { return [] }
+    const [scope, session, text, attachmentIds, displayKind, fromQueue, submissionId] = intent
+
+    return scope === scopeKey && session === target && entry.legacyAttempted === true &&
+      entry.legacyDraftRoute === digest && typeof text === 'string' && text.trim().length > 0 &&
+      !text.trimStart().startsWith('/') && Array.isArray(attachmentIds) && attachmentIds.length === 0 &&
+      !entry.attachments.length && displayKind === null && fromQueue === false &&
+      typeof submissionId === 'string' && submissionId && entry.id === submissionId
+      ? [{ key, id: entry.id, text, attachments: [] }]
+      : []
+  })
+}
+
 export async function readPreparedSubmission(key: string): Promise<PreparedSubmission | undefined> {
   return (await readJournal())[key]
 }
