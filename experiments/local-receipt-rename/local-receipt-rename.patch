diff --git a/hermes_state_profile_rename.py b/hermes_state_profile_rename.py
new file mode 100644
index 0000000000000000000000000000000000000000..5c39277ba5d34468d78d2f9ecab67325e34a9e50
--- /dev/null
+++ b/hermes_state_profile_rename.py
@@ -0,0 +1,77 @@
+"""Preserve a validated LOCAL receipt in the native profile rekey transaction."""
+
+import json
+
+from hermes_state_keys import local_identity
+from hermes_state_local import POLICY_PREFIX
+from hermes_state_local_lineage import validate_local_lineage
+from hermes_state_mutation_guards import require_idle
+from hermes_state_runtime import RuntimeStoreError, _json
+from hermes_state_errors import SessionCompressionInProgressError, SessionTurnLeaseLostError
+from hermes_state_errors import SessionCompressionInProgressError, SessionTurnLeaseLostError
+
+
+def rekey_local_receipts(db, conn, old, new, validate_policy):
+    if db._own_profile_name() != new:
+        raise RuntimeStoreError("profile_mismatch")
+    rows = conn.execute(
+        "SELECT key, value FROM state_meta WHERE key GLOB ?",
+        (POLICY_PREFIX + "*",),
+    ).fetchall()
+    updated = 0
+    old_prefix, new_prefix = f"agent:{old}:local:dm:", f"agent:{new}:local:dm:"
+    for key, raw in rows:
+        try:
+            receipt = json.loads(raw)
+            route = receipt["route"]
+            if not route.startswith((old_prefix, new_prefix)):
+                continue
+            sid = key[len(POLICY_PREFIX):]
+            entry = receipt["entry"]
+            subject = receipt["principal_id"]
+            source = entry["origin"]
+            routed = conn.execute(
+                "SELECT entry_json FROM gateway_routing WHERE scope='' AND session_key=?",
+                (route,),
+            ).fetchone()
+            if (not isinstance(subject, str) or not subject
+                    or receipt["session_id"] != sid
+                    or route not in (old_prefix + sid, new_prefix + sid)
+                    or "legacy_session_id" in receipt
+                    or local_identity(receipt["profile_id"], subject, receipt["request_id"]) != sid
+                    or not isinstance(receipt["policy"], dict)):
+                raise ValueError("invalid creation identity")
+            owner = old if route.startswith(old_prefix) else new
+            if (entry["session_key"] != route or source["profile"] != owner
+                    or (source["platform"], source["chat_type"], source["chat_id"], source["user_id"])
+                    != ("local", "dm", sid, subject)):
+                raise ValueError("invalid receipt route")
+            target = validate_local_lineage(conn, receipt)
+            affected = receipt.get("lineage", [sid])
+            for segment in affected:
+                row = conn.execute(
+                    "SELECT session_key, chat_id, user_id, profile_name FROM sessions WHERE id=?",
+                    (segment,),
+                ).fetchone()
+                if row is None or tuple(row) != (route, sid, subject, owner):
+                    raise ValueError("invalid stored segment")
+            route_entry = json.loads(routed[0]) if routed is not None else {}
+            if (route_entry.get("session_id") != target or route_entry.get("session_key") != route
+                    or route_entry.get("origin") != source):
+                raise ValueError("invalid routing entry")
+            if owner == new:
+                continue
+            validate_policy(receipt["policy"])
+            require_idle(db, conn, affected)
+        except (SessionCompressionInProgressError, SessionTurnLeaseLostError) as exc:
+            raise RuntimeStoreError("session_busy") from exc
+        except RuntimeStoreError:
+            raise
+        except (AttributeError, KeyError, TypeError, ValueError) as exc:
+            raise RuntimeStoreError("storage_unavailable", detail="Invalid LOCAL receipt in renamed profile") from exc
+
+        entry["origin"] = {**source, "profile": new}
+        receipt["route"] = entry["session_key"] = new_prefix + sid
+        conn.execute("UPDATE state_meta SET value=? WHERE key=?", (_json(receipt), key))
+        updated += 1
+    return updated
