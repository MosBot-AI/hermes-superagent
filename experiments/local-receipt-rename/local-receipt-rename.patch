+"""Durable intent for an explicit, local, receipt-preserving profile rename."""
+
+import json
+import os
+import re
+import sqlite3
+import stat
+from contextlib import closing
+from pathlib import Path
+
+from hermes_constants import PROFILE_ID_RE, get_default_hermes_root
+from hermes_state_errors import _STATE_DB_GENERATION_KEY
+from utils import atomic_json_write
+
+RECORD_NAME = ".local-receipt-rename.json"
+
+
+def fsync_directory(path):
+    """Persist the record or profile directory entry before proceeding."""
+    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def load_record(root):
+    path = root / RECORD_NAME
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    except FileNotFoundError:
+        return None
+    try:
+        with os.fdopen(fd, "rb") as stream:
+            info = os.fstat(stream.fileno())
+            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
+                    or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600
+                    or info.st_size > 4096):
+                raise ValueError("unsafe rename record")
+            record = json.loads(stream.read(4097))
+        old, new = record["old"], record["new"]
+        if (record["version"] != 1 or old == new
+                or any(name in {"default", "main"} or not PROFILE_ID_RE.fullmatch(name)
+                       for name in (old, new))
+                or not isinstance(record["store"], dict)):
+            raise ValueError("invalid rename record")
+    except (KeyError, TypeError, ValueError) as exc:
+        raise ValueError("LOCAL receipt rename record is invalid") from exc
+    return record
+
+
+def publish(root, record):
+    atomic_json_write(root / RECORD_NAME, record, mode=0o600)
+    fsync_directory(root)
+
+
+def clear(root):
+    (root / RECORD_NAME).unlink()
+    fsync_directory(root)
+
+
+def identity(home):
+    path = home / "state.db"
+    profile, db = home.lstat(), path.lstat()
+    if (not stat.S_ISDIR(profile.st_mode) or not stat.S_ISREG(db.st_mode)
+            or db.st_nlink != 1):
+        raise ValueError("LOCAL receipt preservation requires a physical profile and private database")
+    with closing(sqlite3.connect(path.as_uri() + "?mode=ro", uri=True)) as conn:
+        header = conn.execute("SELECT value FROM state_meta WHERE key=?",
+                              (_STATE_DB_GENERATION_KEY,)).fetchone()
+    if not header or not isinstance(header[0], str) or not re.fullmatch(r"[0-9a-f]{32}", header[0]):
+        raise ValueError("LOCAL receipt recovery requires the database generation")
+    return {"profile": [profile.st_dev, profile.st_ino],
+            "database": [db.st_dev, db.st_ino], "generation": header[0]}
+
+
+def verify(home, record):
+    if identity(home) != record["store"]:
+        raise ValueError("The LOCAL receipt rename store was replaced")
+
+
+def refuse_pending_rename(home: Path):
+    from gateway.runtime_ownership import OwnershipConflict
+
+    if os.name != "posix":
+        return
+    home = home.resolve()
+    root = get_default_hermes_root(home=home).resolve()
+    if home != root and home.parent != root / "profiles":
+        return
+    try:
+        record = load_record(root)
+    except (OSError, ValueError) as exc:
+        raise OwnershipConflict("Cannot verify pending LOCAL receipt rename") from exc
+    if record is not None and (home == root or home.name in (record["old"], record["new"])):
+        raise OwnershipConflict(
+            f"LOCAL receipt rename is pending. Repeat: hermes profile rename "
+            f"{record['old']} {record['new']} --preserve-local-sessions"
+        )
