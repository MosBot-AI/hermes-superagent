+    """Run only as an explicit same-installation rename of the actual stopped home."""
+    from gateway.runtime_ownership import exclusive_maintenance
+    from gateway.session_policy import restore_policy
+    from hermes_cli.profiles import _rename_profile, get_profile_dir
+    from hermes_state_registry import acquire, release_or_close
+    from hermes_state_runtime import RuntimeStoreError
+
+    root, source, destination = (get_profile_dir(name) for name in ("default", old, new))
+    if source.is_symlink() or not source.is_dir() or source.parent.resolve() != root.resolve() / "profiles":
+        raise ValueError("LOCAL receipt preservation requires the original profile directory")
+    if destination.exists() or destination.is_symlink():
+        raise FileExistsError("The destination profile already exists")
+    identity = source.stat()
+
+    def move(old_dir, new_dir):
+        current = old_dir.lstat()
+        if (current.st_dev, current.st_ino) != (identity.st_dev, identity.st_ino):
+            raise ValueError("The profile directory changed during rename")
+        db_path = old_dir / "state.db"
+        info = db_path.lstat()
+        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
+            raise ValueError("LOCAL receipt preservation requires a private state database")
+        # The held lock inode travels with the directory. Publish the receipt and
+        # its native routing changes before releasing that lock.
+        _rename_noreplace(old_dir, new_dir)
+        try:
+            db = acquire(new_dir / "state.db")
+            try:
+                def validate_policy(data):
+                    policy = restore_policy(data)
+                    if Path(policy.cwd).resolve().is_relative_to(old_dir.resolve()):
+                        raise RuntimeStoreError("invalid_params", detail="LOCAL policy uses the moved profile as its workspace")
+                db.rekey_profile_state(old, new, local_receipt_policy=validate_policy)
+            finally:
+                release_or_close(db)
+        except (RuntimeStoreError, sqlite3.IntegrityError) as exc:
+            # A validation error rolls back the SQLite transaction. Restore the
+            # prior namespace before any sidecar, alias or service is republished.
+            _rename_noreplace(new_dir, old_dir)
+            if isinstance(exc, RuntimeStoreError) and exc.detail:
+                raise ValueError(f"{exc.reason}: {exc.detail}") from exc
+            raise
+        except (OSError, sqlite3.Error, ValueError) as exc:
+            raise ValueError("LOCAL receipt migration could not confirm settlement after the move") from exc
+
+    with exclusive_maintenance([root, source], purpose="profile-rename"):
+        return _rename_profile(old, new, move=move)
+
