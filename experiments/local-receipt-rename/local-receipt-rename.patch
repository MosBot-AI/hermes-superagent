 from pathlib import Path
 
 
+def _rename_noreplace(source: Path, destination: Path) -> None:
+    """Linux rename with an atomic refusal if any destination entry exists."""
+    libc = ctypes.CDLL(None, use_errno=True)
+    try:
+        renameat2 = libc.renameat2
+    except AttributeError as exc:
+        raise ValueError("LOCAL receipt preservation requires renameat2 support") from exc
+    renameat2.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
+    renameat2.restype = ctypes.c_int
+    # Keep the standard rename audit visible to tooling around the native CLI.
+    sys.audit("os.rename", source, destination, -1, -1)
+    at_fdcwd, rename_noreplace = -100, 1
+    if renameat2(at_fdcwd, os.fsencode(source), at_fdcwd, os.fsencode(destination), rename_noreplace):
+        error = ctypes.get_errno()
+        if error in (errno.ENOSYS, errno.EINVAL, errno.EOPNOTSUPP):
+            raise ValueError("This filesystem does not support exclusive profile rename")
+        raise OSError(error, os.strerror(error), str(source), None, str(destination))
+
+
