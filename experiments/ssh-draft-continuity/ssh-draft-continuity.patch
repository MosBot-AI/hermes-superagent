diff --git a/tui_gateway/draft_continuity.py b/tui_gateway/draft_continuity.py
new file mode 100644
index 0000000000000000000000000000000000000000..8977ae064792dcfa945dbbee741d074656101c49
--- /dev/null
+++ b/tui_gateway/draft_continuity.py
@@ -0,0 +1,30 @@
+"""Read-only continuity evidence for recovering a local journal draft."""
+
+from hashlib import sha256
+import json
+import re
+import sqlite3
+
+from gateway.drain_control import current_instantiation_epoch
+from hermes_state_errors import _STATE_DB_GENERATION_KEY
+
+
+def session_draft_continuity(db, stored_session_id: str) -> str | None:
+    """Bind an exact stored row to this backend's current physical SQLite file."""
+    epoch = current_instantiation_epoch()
+    file_identity = db._db_file_identity
+    if not epoch or epoch.startswith(":") or not file_identity or db._db_file_was_replaced():
+        return None
+    try:
+        row = db._read_one(
+            "SELECT s.started_at, m.value FROM sessions s JOIN state_meta m ON m.key = ? WHERE s.id = ?",
+            (_STATE_DB_GENERATION_KEY, stored_session_id),
+        )
+    except sqlite3.Error:
+        return None
+    if not row or not isinstance(row[1], str) or not re.fullmatch(r"[0-9a-f]{32}", row[1]):
+        return None
+    if db._db_file_identity != file_identity or db._db_file_was_replaced():
+        return None
+    evidence = json.dumps(["ssh-draft-v1", epoch, *file_identity, row[1], stored_session_id, row[0]])
+    return sha256(evidence.encode()).hexdigest()
