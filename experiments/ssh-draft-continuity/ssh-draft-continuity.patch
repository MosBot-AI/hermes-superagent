new file mode 100644
index 0000000000000000000000000000000000000000..6f608139e80312abe8ea5645b6d9b40cf4240899
--- /dev/null
+++ b/tests/tui_gateway/test_draft_continuity.py
@@ -0,0 +1,37 @@
+import sqlite3
+
+from hermes_state import SessionDB
+from hermes_state_errors import _STATE_DB_GENERATION_KEY
+from tui_gateway import draft_continuity, server
+
+
+def test_exact_store_survives_reopen_and_refuses_a_physical_copy(tmp_path, monkeypatch):
+    monkeypatch.setattr(draft_continuity, "current_instantiation_epoch", lambda: "boot:1")
+    original, copied = tmp_path / "original.db", tmp_path / "copied.db"
+    with SessionDB(original) as db:
+        db.create_session("stored", source="cli")
+        initial = draft_continuity.session_draft_continuity(db, "stored")
+        assert initial and len(initial) == 64
+        db.append_message("stored", "user", "fixture turn")
+        assert draft_continuity.session_draft_continuity(db, "stored") == initial
+        assert draft_continuity.session_draft_continuity(db, "missing") is None
+
+    with sqlite3.connect(original) as source, sqlite3.connect(copied) as target:
+        source.backup(target)
+    with SessionDB(original) as db, SessionDB(copied) as other:
+        assert db.get_meta(_STATE_DB_GENERATION_KEY) == other.get_meta(_STATE_DB_GENERATION_KEY)
+        assert draft_continuity.session_draft_continuity(db, "stored") == initial
+        assert draft_continuity.session_draft_continuity(other, "stored") not in (None, initial)
+        monkeypatch.setattr(draft_continuity, "current_instantiation_epoch", lambda: "")
+        assert draft_continuity.session_draft_continuity(db, "stored") is None
+
+
+def test_mismatch_stops_legacy_submit_before_side_effects(monkeypatch):
+    monkeypatch.setitem(server._sessions, "runtime", {"session_key": "stored"})
+    monkeypatch.setattr(server, "_active_draft_continuity", lambda *_: "a" * 64)
+    reply = server.handle_request({
+        "jsonrpc": "2.0", "id": 1, "method": "prompt.submit",
+        "params": {"session_id": "runtime", "profile": "scout", "text": "draft",
+                   "draft_continuity": "b" * 64},
+    })
+    assert reply["error"]["message"] == "draft session continuity changed"
