+def wire_message_content(message: dict[str, Any]) -> Any:
+    """Select provider-facing content and relabel legacy host recall on the wire copy.
+
+    String turns carry the injected frame in their sidecar. Preserve an original
+    text prefix byte-for-byte when it is still present in the sidecar. Multimodal
+    turns carry the injected frame in an appended text part. The exact old host
+    header is reserved in those carriers; ordinary text and other roles are not
+    interpreted as recall. Historical rows are never changed by this projection.
+    """
+    content = message.get("content")
+    sidecar = message.get("api_content")
+    role = message.get("role")
+    if isinstance(sidecar, str) and sidecar and role in ("user", "assistant"):
+        if role == "assistant" or _LEGACY_RECALL_OPEN not in sidecar:
+            return sidecar
+        prefix = content if isinstance(content, str) and sidecar.startswith(content) else ""
+        suffix = sidecar[len(prefix):]
+        if suffix.startswith(_LEGACY_RECALL_OPEN):
+            suffix = _RECALL_OPEN + suffix[len(_LEGACY_RECALL_OPEN):]
+        return prefix + suffix.replace("\n" + _LEGACY_RECALL_OPEN, "\n" + _RECALL_OPEN)
+    if role == "user" and isinstance(content, list):
+        updated = None
+        for index, part in enumerate(content):
+            if not isinstance(part, dict) or part.get("type") != "text":
+                continue
+            text = part.get("text")
+            if isinstance(text, str) and text.startswith(_LEGACY_RECALL_OPEN):
+                if updated is None:
+                    updated = content.copy()
+                updated[index] = {**part, "text": _RECALL_OPEN + text[len(_LEGACY_RECALL_OPEN):]}
+        if updated is not None:
+            return updated
+    return content
