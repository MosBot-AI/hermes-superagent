+def test_recoverable_output_is_adopted_only_in_the_log_profile(tmp_path, monkeypatch):
+    from tools.process_registry import ProcessRegistry
+    from tools.process_registry_output_log import output_dir
+
+    launch = tmp_path / "launch"
+    sender = launch / "profiles" / "scout"
+    monkeypatch.setenv("HERMES_HOME", str(sender))
+    log = output_dir() / "proc_bot_waiter.log"
+    log.parent.mkdir(parents=True)
+    log.write_text("synthetic reply\n", encoding="utf-8")
+    log.with_suffix(".exit").write_text("0\n", encoding="ascii")
+    entry = {
+        "session_id": "proc_bot_waiter",
+        "command": "synthetic",
+        "pid": 2**22 + 7,
+        "started_at": 123,
+        "parent_session_id": "sender",
+        "watcher_platform": "local",
+        "watcher_interval": 5,
+        "notify_on_complete": True,
+        "recoverable_output": True,
+        "output_log": str(log),
+    }
+    for profile in (launch, sender):
+        (profile / "processes.json").write_text(json.dumps([entry]), encoding="utf-8")
+
+    registry = ProcessRegistry()
+    monkeypatch.setenv("HERMES_HOME", str(launch))
+    assert registry.recover_from_checkpoint() == 0
+    assert registry.get(entry["session_id"]) is None
+    assert not registry.pending_watchers
+    assert list((launch / "logs").glob("process-results/*")) == []
+
+    monkeypatch.setenv("HERMES_HOME", str(sender))
+    assert registry.recover_from_checkpoint() == 1
+    process = registry.get(entry["session_id"])
+    assert process is not None and process._completion_event.wait(5)
+    assert (process.output_buffer, process.exit_code, process.started_at) == ("synthetic reply\n", 0, 123)
+    assert process.parent_session_id == "sender"
+    assert len(registry.pending_watchers) == 1
+
+
+def test_failed_bot_result_keeps_only_its_own_recent_handoff(tmp_path, monkeypatch):
+    import os
+
+    from tools import process_registry as pr
+    from tools.process_registry_output_log import output_dir
+    from tools.process_registry_results import RESULT_RETENTION_SECONDS, save_completed_result
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    checkpoint = tmp_path / "processes.json"
+    monkeypatch.setattr(pr, "CHECKPOINT_PATH", checkpoint)
+    output_dir().mkdir(parents=True)
+    registry = pr.ProcessRegistry()
+    session = pr.ProcessSession(
+        id="proc_bot_waiter", command="synthetic", pid=123, started_at=10,
+        parent_session_id="sender", session_key="agent:local:sender",
+        watcher_platform="local", watcher_interval=5, notify_on_complete=True,
+        recoverable_output=True, exited=True,
+    )
+    log = output_dir() / f"{session.id}.log"
+    log.write_text("reply\n", encoding="utf-8")
+    exit_record = log.with_suffix(".exit")
+    exit_record.write_text("0\n", encoding="ascii")
+    handoff = {name: getattr(session, name) for name in pr._CHECKPOINT_FIELDS}
+    handoff.update(session_id=session.id, output_log=str(log))
+    checkpoint.write_text(json.dumps([handoff]), encoding="utf-8")
+    registry._finished[session.id] = session
+
+    registry._write_checkpoint()
+    assert json.loads(checkpoint.read_bytes()) == [handoff]
+    wrong = pr.ProcessSession(
+        id=session.id, command="synthetic", started_at=session.started_at,
+        parent_session_id="another-sender", session_key=session.session_key,
+        watcher_platform="local", watcher_interval=5, notify_on_complete=True,
+        recoverable_output=True, exited=True,
+    )
+    save_completed_result(wrong)
+    registry._write_checkpoint()
+    assert json.loads(checkpoint.read_bytes()) == [handoff]
+
+    save_completed_result(session)
+    registry._write_checkpoint()
+    assert json.loads(checkpoint.read_bytes()) == []
+
+    result = tmp_path / "logs" / "process-results" / f"{session.id}.json"
+    result.unlink()
+    checkpoint.write_text(json.dumps([handoff]), encoding="utf-8")
+    expired = time.time() - RESULT_RETENTION_SECONDS - 1
+    os.utime(exit_record, (expired, expired))
+    registry._write_checkpoint()
+    assert json.loads(checkpoint.read_bytes()) == []
