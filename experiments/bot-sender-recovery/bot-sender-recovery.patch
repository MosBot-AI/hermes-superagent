+def test_recoverable_output_is_adopted_only_in_the_log_profile(tmp_path, monkeypatch):
+    from tools.process_registry import ProcessRegistry
+    from tools.process_registry_output_log import output_dir
+
+    launch = tmp_path / "launch"
+    sender = launch / "profiles" / "scout"
+    monkeypatch.setenv("HERMES_HOME", str(sender))
+    log = output_dir() / "proc_bot_waiter.log"
+    log.parent.mkdir(parents=True)
+    log.write_text("synthetic reply\n", encoding="utf-8")
+    log.with_suffix(".exit").write_text("0\n", encoding="ascii")
+    entry = {
+        "session_id": "proc_bot_waiter",
+        "command": "synthetic",
+        "pid": 2**22 + 7,
+        "started_at": 123,
+        "parent_session_id": "sender",
+        "watcher_platform": "local",
+        "watcher_interval": 5,
+        "notify_on_complete": True,
+        "recoverable_output": True,
+        "output_log": str(log),
+    }
+    for profile in (launch, sender):
+        (profile / "processes.json").write_text(json.dumps([entry]), encoding="utf-8")
+
+    registry = ProcessRegistry()
+    monkeypatch.setenv("HERMES_HOME", str(launch))
+    assert registry.recover_from_checkpoint() == 0
+    assert registry.get(entry["session_id"]) is None
+    assert not registry.pending_watchers
+    assert list((launch / "logs").glob("process-results/*")) == []
+
+    monkeypatch.setenv("HERMES_HOME", str(sender))
+    assert registry.recover_from_checkpoint() == 1
+    process = registry.get(entry["session_id"])
+    assert process is not None and process._completion_event.wait(5)
+    assert (process.output_buffer, process.exit_code, process.started_at) == ("synthetic reply\n", 0, 123)
+    assert process.parent_session_id == "sender"
+    assert len(registry.pending_watchers) == 1
