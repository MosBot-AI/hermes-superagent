diff --git a/hermes_cli/plugin_http_principal.py b/hermes_cli/plugin_http_principal.py
new file mode 100644
index 00000000..30190fed
--- /dev/null
+++ b/hermes_cli/plugin_http_principal.py
@@ -0,0 +1,65 @@
+"""Request-local provider identity for dashboard plugin routes."""
+
+from dataclasses import dataclass, fields
+
+from starlette.requests import HTTPConnection
+
+from hermes_cli.dashboard_auth.base import Session
+
+
+@dataclass(frozen=True, repr=False)
+class DashboardPluginPrincipal:
+    """Verified provider identity and effective host routing scope at request admission."""
+
+    provider: str
+    issuer: str
+    subject: str
+    organization: str
+    credential_kind: str
+    profile_name: str
+
+
+_FIELDS = frozenset(field.name for field in fields(DashboardPluginPrincipal))
+_CREDENTIAL_KINDS = frozenset({"cookie_session", "provider_bearer"})
+
+
+def _decode_principal(value: object) -> DashboardPluginPrincipal | None:
+    if type(value) is not dict or value.keys() != _FIELDS:
+        return None
+    for name, text in value.items():
+        if type(text) is not str or len(text) > 1024 or text != text.strip():
+            return None
+        if not text and name == "organization":
+            continue
+        if not text or not text.isprintable():
+            return None
+    if value["credential_kind"] not in _CREDENTIAL_KINDS:
+        return None
+    return DashboardPluginPrincipal(**value)
+
+
+def bound_plugin_principal(request: HTTPConnection) -> DashboardPluginPrincipal | None:
+    """Build the snapshot inside the dashboard host's effective plugin profile scope."""
+    from gateway.host_attach import profile_name_for_home
+    from hermes_constants import get_hermes_home
+
+    session = getattr(request.state, "session", None)
+    kind = getattr(request.state, "verified_dashboard_session_kind", None)
+    if request.scope["type"] != "http" or type(session) is not Session:
+        return None
+    return _decode_principal({
+        "provider": session.provider,
+        "issuer": session.issuer,
+        "subject": session.user_id,
+        "organization": session.org_id,
+        "credential_kind": kind,
+        "profile_name": profile_name_for_home(get_hermes_home()),
+    })
+
+
+def get_plugin_http_principal(request: HTTPConnection) -> DashboardPluginPrincipal | None:
+    """Read a host snapshot from this dashboard plugin HTTP request, if supported."""
+    if request.scope["type"] != "http":
+        return None
+    principal = getattr(request.state, "dashboard_plugin_principal", None)
+    return principal if type(principal) is DashboardPluginPrincipal else None
