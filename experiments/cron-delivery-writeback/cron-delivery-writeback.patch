+def terminal_receipts(execution_ids: list[str]) -> dict[str, dict]:
+    """Batched exact-ID metadata lookup, including receipts pruned to tombstones."""
+    if not execution_ids:
+        return {}
+    receipts = {}
+    with _transaction() as conn:
+        for offset in range(0, len(execution_ids), 400):
+            batch = execution_ids[offset:offset + 400]
+            placeholders = ",".join("?" for _ in batch)
+            rows = conn.execute(
+                f"""SELECT execution_id, status, error FROM deliveries
+                    WHERE execution_id IN ({placeholders})
+                      AND status IN ('delivered','failed','unknown','suppressed')
+                    UNION ALL
+                    SELECT execution_id, terminal_status, NULL FROM delivery_tombstones
+                    WHERE execution_id IN ({placeholders})""",
+                (*batch, *batch),
+            )
+            receipts.update((row["execution_id"], dict(row)) for row in rows)
+    return receipts
+
