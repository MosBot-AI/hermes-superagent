+def test_transport_classifier_safe_cause_chains():
+    import httpcore
+    import socket
+    import ssl
+    from agent.text_subagent import _transport_failure
+    for inner, expected in [(ssl.SSLCertVerificationError("PRIVATE"), "TLS_VERIFY_FAILED"),
+                            (socket.gaierror(99, "PRIVATE"), "DNS_FAILED")]:
+        outer = httpx.ConnectError("PRIVATE")
+        middle = httpcore.ConnectError("PRIVATE")
+        outer.__cause__ = middle
+        middle.__cause__ = inner
+        assert _transport_failure(outer) == "TEXT_WORKER_" + expected
+    outer.__cause__ = outer
+    assert _transport_failure(outer) == "TEXT_WORKER_FAILED"
+    outer = httpx.ReadError("PRIVATE")
+    current = outer
+    for _ in range(8):
+        current.__cause__ = httpx.ReadError("PRIVATE")
+        current = current.__cause__
+    assert _transport_failure(outer) == "TEXT_WORKER_FAILED"
+    outer.__cause__ = ValueError("PRIVATE")
+    assert _transport_failure(outer) == "TEXT_WORKER_FAILED"
