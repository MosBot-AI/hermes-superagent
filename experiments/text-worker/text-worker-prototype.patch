+def test_timeout_discards_response_without_retry(world, monkeypatch):
+    from agent import text_subagent
+    expired = threading.Event()
+    class Timer:
+        daemon = False
+        def __init__(self, seconds, callback):
+            self.callback = callback
+        def start(self):
+            pass
+        def cancel(self):
+            pass
+    timers = []
+    def timer(seconds, callback):
+        value = Timer(seconds, callback); timers.append(value); return value
+    monkeypatch.setattr(text_subagent.threading, "Timer", timer)
+    def answer(req):
+        timers[0].callback()
+        expired.set()
+        return world.answer(req)
+    world.handler[0] = answer
+    _, result = finish(world)
+    assert expired.is_set() and len(world.calls) == 1
+    assert result.error_classification == "TIMEOUT" and result.summary is None
+
