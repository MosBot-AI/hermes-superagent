+@pytest.fixture
+def world(tmp_path, monkeypatch):
+    from hermes_cli import plugins
+    from hermes_constants import get_hermes_home
+    home = get_hermes_home()
+    home.mkdir(exist_ok=True, parents=True)
+    route = {"provider": "opencode-go", "model": "deepseek-v4.1-flash", "base_url": "https://text.test/v1"}
+    config = {"plugins": {"entries": {"planner": {"granted_capabilities": ["llm.text_worker"], "text_workers": {"enabled": True, "routes": [route]}}}}}
+    def save():
+        (home / "config.yaml").write_text(json.dumps(config))
+    save()
+    calls = []
+    def answer(request):
+        calls.append(json.loads(request.content))
+        return httpx.Response(200, json={"id": "fake", "object": "chat.completion", "created": 1,
+                                       "model": route["model"], "choices": [{"index": 0,
+                                       "message": {"role": "assistant", "content": "A planning draft"},
+                                       "finish_reason": "stop"}],
+                                       "usage": {"prompt_tokens": 12, "completion_tokens": 4, "total_tokens": 16}})
+    handler = [answer]
+    from agent import text_subagent
+    children = []
+    real_factory = text_subagent._new_http_client
+    def make_client(timeout):
+        child = httpx.Client(timeout=timeout, trust_env=False, follow_redirects=False,
+                             transport=httpx.MockTransport(lambda req: handler[0](req)))
+        children.append(child)
+        return child
+    monkeypatch.setattr(text_subagent, "_new_http_client", make_client)
+    client = OpenAI(api_key="synthetic-not-a-credential", base_url=route["base_url"],
+                    http_client=httpx.Client(transport=httpx.MockTransport(lambda req: handler[0](req))))
+    parent = SimpleNamespace(**route, session_id="parent", api_mode="chat_completions", client=client,
+                             request_overrides={}, prefill_messages=[{"secret": "must-not-send"}], tools=["terminal"])
+    manager = PluginManager()
+    monkeypatch.setattr(plugins, "_delivery_manager", lambda: manager)
+    ctx = PluginContext(PluginManifest(name="planner"), manager)
+    with bind_subagent_parent(parent):
+        yield SimpleNamespace(service=ctx.subagent_lifecycle, ctx=ctx, manager=manager, parent=parent, route=route,
+                              calls=calls, config=config, save=save, handler=handler, answer=answer, home=home, children=children, real_factory=real_factory)
+    assert all(child.is_closed for child in children)
+    client.close()
