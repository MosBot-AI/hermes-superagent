+def test_queued_request_rechecks_config_without_call(world, monkeypatch):
+    from agent import subagent_lifecycle as lifecycle
+    from concurrent.futures import Future
+    jobs = []
+    def submit(*args):
+        future = Future(); jobs.append((args, future)); return future
+    monkeypatch.setattr(lifecycle._EXECUTOR, "submit", submit)
+    handle = world.service.launch_text(request(correlation_id="queued"))
+    with pytest.raises(SubagentLifecycleError):
+        world.service.launch_text(request(correlation_id="queued"))
+    world.config["plugins"]["entries"]["planner"]["text_workers"]["enabled"] = False
+    world.save()
+    args, future = jobs[0]
+    future.set_result(args[0](*args[1:]))
+    assert world.service.result(handle).terminal_state == SubagentState.FAILED
+    assert not world.calls
