--- /dev/null
+++ b/tests/agent/test_text_subagent.py
@@ -0,0 +1,457 @@
+"""Text-worker proposal: real SDK/transport/middleware, in-memory HTTP only."""
+import dataclasses
+import json
+import threading
+from concurrent.futures import ThreadPoolExecutor
+from types import SimpleNamespace
+
+import httpx
+import pytest
+from openai import OpenAI
+
+from agent.subagent_lifecycle import (
+    SubagentLifecycleError, SubagentLifecycleService, SubagentState, TextSubagentRequest,
+    bind_subagent_parent,
+)
+from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+
+
+@pytest.fixture
+def world(tmp_path, monkeypatch):
+    from hermes_cli import plugins
+    from hermes_constants import get_hermes_home
+    home = get_hermes_home()
+    home.mkdir(exist_ok=True, parents=True)
+    route = {"provider": "opencode-go", "model": "deepseek-v4.1-flash", "base_url": "https://text.test/v1"}
+    config = {"plugins": {"entries": {"planner": {"text_workers": {"enabled": True, "routes": [route]}}}}}
+    def save():
+        (home / "config.yaml").write_text(json.dumps(config))
+    save()
+    calls = []
+    def answer(request):
+        calls.append(json.loads(request.content))
+        return httpx.Response(200, json={"id": "fake", "object": "chat.completion", "created": 1,
+                                       "model": route["model"], "choices": [{"index": 0,
+                                       "message": {"role": "assistant", "content": "A planning draft"},
+                                       "finish_reason": "stop"}],
+                                       "usage": {"prompt_tokens": 12, "completion_tokens": 4, "total_tokens": 16}})
+    handler = [answer]
+    client = OpenAI(api_key="synthetic-not-a-credential", base_url=route["base_url"],
+                    http_client=httpx.Client(transport=httpx.MockTransport(lambda req: handler[0](req))))
+    parent = SimpleNamespace(**route, session_id="parent", api_mode="chat_completions", client=client,
+                             request_overrides={}, prefill_messages=[{"secret": "must-not-send"}], tools=["terminal"])
+    manager = PluginManager()
+    monkeypatch.setattr(plugins, "_delivery_manager", lambda: manager)
+    ctx = PluginContext(PluginManifest(name="planner"), manager)
+    with bind_subagent_parent(parent):
+        yield SimpleNamespace(service=ctx.subagent_lifecycle, ctx=ctx, manager=manager, parent=parent, route=route,
+                              calls=calls, config=config, save=save, handler=handler, answer=answer, home=home)
+    client.close()
+
+
+def request(**overrides):
+    return TextSubagentRequest("Draft next steps", "opencode-go", "deepseek-v4.1-flash", **overrides)
+
+
+def finish(w, req=None):
+    handle = w.service.launch_text(req or request())
+    assert w.service.wait(handle, timeout_seconds=5).completed
+    return handle, w.service.result(handle)
+
+
+def test_native_context_real_transport_is_task_only(world):
+    handle, result = finish(world, request(context="one selected task", correlation_id="task-1"))
+    assert result.terminal_state == SubagentState.SUCCEEDED
+    assert result.summary == "A planning draft" and result.usage_metadata["api_calls"] == 1
+    assert result.tool_execution_summary == {"tool_calls": 0} and len(result.result_hash) == 64
+    wire = world.calls[0]
+    assert set(wire) == {"model", "messages", "max_tokens"}
+    assert json.loads(wire["messages"][1]["content"]) == {"goal": "Draft next steps", "context": "one selected task"}
+    assert "must-not-send" not in json.dumps(wire) and "terminal" not in json.dumps(wire)
+    assert not world.service.steer(handle, "run terminal")
+    assert world.service.reconnect(handle).connected
+
+
+@pytest.mark.parametrize("mutation", [
+    {"enabled": False}, {"enabled": "true"}, {"routes": []}, {"routes": [{"provider": "opencode-go"}]},
+])
+def test_config_default_and_exact_route(world, mutation):
+    world.config["plugins"]["entries"]["planner"]["text_workers"].update(mutation)
+    world.save()
+    with pytest.raises(SubagentLifecycleError):
+        world.service.launch_text(request())
+    assert not world.calls
+
+
+def test_missing_grant(world):
+    world.config.clear(); world.save()
+    with pytest.raises(SubagentLifecycleError):
+        world.service.launch_text(request())
+
+
+@pytest.mark.parametrize("changes", [
+    {"goal": ""}, {"goal": "x" * 16001}, {"context": "x" * 32001}, {"goal": 1},
+    {"max_tokens": True}, {"max_tokens": 4097}, {"timeout_seconds": float("nan")},
+    {"timeout_seconds": 0}, {"timeout_seconds": True}, {"allowed_toolsets": []},
+    {"provider": "custom"}, {"model": "other"}, {"parent_session_id": "other"},
+])
+def test_invalid_inputs(world, changes):
+    data = dataclasses.asdict(request()); data.update(changes)
+    with pytest.raises(SubagentLifecycleError):
+        world.service.launch_text(data)
+    assert not world.calls
+
+
+@pytest.mark.parametrize("name,value", [
+    ("request_overrides", {"tools": []}), ("api_mode", "codex_app_server"),
+    ("acp_command", "agent-cli"), ("provider", "moa"), ("client", object()),
+    ("base_url", "https://other.test"),
+])
+def test_unsupported_parent_refuses(world, name, value):
+    setattr(world.parent, name, value)
+    with pytest.raises(SubagentLifecycleError):
+        world.service.launch_text(request())
+    assert not world.calls
+
+
+@pytest.mark.parametrize("injection", [{"model": "other"}, {"extra_body": {"tools": [{"type": "web_search"}]}},
+                                      {"tools": []}, {"messages": []}, {"stream": True}])
+def test_execution_middleware_cannot_change_wire(world, injection):
+    def middleware(request, next_call, **kwargs):
+        request.update(injection)
+        try:
+            return next_call(request)
+        except Exception:
+            return object()  # swallowing refusal must not manufacture success
