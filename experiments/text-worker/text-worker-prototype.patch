+
+def test_text_worker_contract_is_readonly_metadata_not_authorization(world, monkeypatch):
+    service = world.ctx.subagent_lifecycle
+    assert service.text_worker_contract == "hermes.text-worker.v1"
+    with pytest.raises(AttributeError):
+        service.text_worker_contract = "other"
+    with pytest.raises(AttributeError):
+        del service.text_worker_contract
+    # The descriptor also cannot be shadowed by an instance dictionary entry.
+    service.__dict__["text_worker_contract"] = "other"
+    assert service.text_worker_contract == "hermes.text-worker.v1"
+
+    def forbidden(*args, **kwargs):
+        raise AssertionError("Text contract refusal must not use ordinary child launch")
+
+    monkeypatch.setattr(service, "launch", forbidden)
+    world.config["plugins"]["entries"]["planner"]["text_workers"]["enabled"] = False
+    world.save()
+    # Feature detection itself does not resolve a parent, create a client or
+    # obtain permission. Enforcement remains in the dedicated text methods.
+    monkeypatch.setattr(service, "_parent_agent_resolver", forbidden)
+    assert service.text_worker_contract == "hermes.text-worker.v1"
+    monkeypatch.setattr(service, "_parent_agent_resolver", lambda: world.parent)
+    with pytest.raises(SubagentLifecycleError):
+        service.launch_text(request())
+    assert world.calls == [] and world.children == []
