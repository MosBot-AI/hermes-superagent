--- /dev/null
+++ b/agent/text_subagent.py
@@ -0,0 +1,396 @@
+"""Opt-in bounded text workers. No credential resolver, agent loop, or tool executor.
+
+Trusted in-process plugins/middleware are not sandboxed. Cancellation and timeout
+suppress late results; an HTTP request already submitted may still incur cost.
+"""
+from __future__ import annotations
+
+import contextvars
+import copy
+import dataclasses
+import hashlib
+import json
+import math
+import threading
+import time
+import uuid
+from typing import Any, Mapping
+from urllib.parse import urlsplit
+
+
+@dataclasses.dataclass(frozen=True)
+class TextSubagentRequest:
+    goal: str
+    provider: str
+    model: str
+    context: str | None = None
+    parent_session_id: str | None = None
+    correlation_id: str | None = None
+    max_tokens: int = 2048
+    timeout_seconds: float = 30.0
+    expected_route_fingerprint: str | None = None
+
+
+_SYSTEM = "Produce a text-only planning draft from the supplied task data. Do not claim to have performed actions."
+# Deliberately small direct Chat Completions surface for this prototype.
+_PROVIDERS = frozenset({"openai", "deepseek", "opencode-go"})
+
+
+def _transport_failure(error):
+    """Fixed diagnostics only: never inspect exception text, request, response or errno.
+
+    Follow at most eight explicit causes of exact known transport exception types.
+    Unknown wrappers/subclasses, cycles and deeper chains fail closed to generic.
+    These codes describe an observed failure, not delivery or charging certainty.
+    """
+    import httpcore
+    import httpx
+    import socket
+    import ssl
+
+    codes = {}
+    for module in (httpx, httpcore):
+        for name, code in (
+            ("ConnectError", "CONNECT_FAILED"), ("ConnectTimeout", "CONNECT_TIMEOUT"),
+            ("ReadTimeout", "READ_TIMEOUT"), ("WriteTimeout", "WRITE_TIMEOUT"),
+            ("PoolTimeout", "POOL_TIMEOUT"), ("ReadError", "READ_FAILED"),
+            ("WriteError", "WRITE_FAILED"), ("LocalProtocolError", "PROTOCOL_FAILED"),
+            ("RemoteProtocolError", "PROTOCOL_FAILED"),
+        ):
+            codes[getattr(module, name)] = "TEXT_WORKER_" + code
+    codes[ssl.SSLCertVerificationError] = "TEXT_WORKER_TLS_VERIFY_FAILED"
+    codes[socket.gaierror] = "TEXT_WORKER_DNS_FAILED"
+    # Ordinary OS/TLS leaves carry no independently trustworthy diagnostic.
+    # Preserve only a known outer transport classification, never inspect errno.
+    leaves = {OSError, ConnectionRefusedError, ConnectionResetError,
+              ConnectionAbortedError, BrokenPipeError, TimeoutError, ssl.SSLError,
+              ssl.SSLEOFError, ssl.SSLZeroReturnError, ssl.SSLWantReadError,
+              ssl.SSLWantWriteError}
+    seen = set()
+    code = "TEXT_WORKER_FAILED"
+    for _ in range(8):
+        if id(error) in seen or type(error) not in codes.keys() | leaves:
+            return "TEXT_WORKER_FAILED"
+        seen.add(id(error))
+        # Base descriptor bypasses user-defined attribute access on subclasses.
+        cause = BaseException.__cause__.__get__(error)
+        if type(error) in leaves:
+            return code if cause is None else "TEXT_WORKER_FAILED"
+        code = codes[type(error)]
+        if cause is None:
+            return code
+        error = cause
+    return "TEXT_WORKER_FAILED"
+
+
+def _refuse():
+    from agent.subagent_lifecycle import SubagentLifecycleError
+    raise SubagentLifecycleError("Text worker request refused.")
+
+
+def _request(value):
+    try:
+        if isinstance(value, Mapping):
+            value = TextSubagentRequest(**dict(value))
+        if not isinstance(value, TextSubagentRequest):
+            _refuse()
+        for name, limit, required in (
+            ("goal", 16000, True), ("context", 32000, False), ("provider", 64, True),
+            ("model", 256, True), ("parent_session_id", 256, False), ("correlation_id", 256, False),
+        ):
+            field = getattr(value, name)
+            if field is None and not required:
+                continue
+            if not isinstance(field, str) or not field.strip() or len(field) > limit:
+                _refuse()
+        stamp = value.expected_route_fingerprint
+        if stamp is not None and (type(stamp) is not str or len(stamp) != 64
+                                  or any(c not in "0123456789abcdef" for c in stamp)):
+            _refuse()
+        if type(value.max_tokens) is not int or not 1 <= value.max_tokens <= 4096:
+            _refuse()
+        if (type(value.timeout_seconds) not in (int, float) or not math.isfinite(value.timeout_seconds)
+                or not 1 <= value.timeout_seconds <= 120):
+            _refuse()
+    except (TypeError, ValueError):
+        _refuse()
+    return value
+
+
+def _route(parent):
+    client = getattr(parent, "client", None)
+    identity = tuple(getattr(client, key, None) for key in ("api_key", "organization", "project"))
+    return (*tuple(getattr(parent, key, None) for key in ("provider", "model", "base_url", "api_mode", "client")), identity)
+
+
+def _new_http_client(timeout):
+    """Private host factory; tests replace this with a fresh MockTransport client.
+
+    Never borrow parent sockets, auth, hooks, transports, proxy or env configuration.
+    """
+    import ssl
+    import certifi
+    import httpx
+    # create_default_context reads SSLKEYLOGFILE even when HTTPX trust_env=False.
+    tls = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
+    tls.load_verify_locations(cafile=certifi.where())
+    return httpx.Client(timeout=timeout, trust_env=False, follow_redirects=False,
+                        transport=httpx.HTTPTransport(retries=0, trust_env=False, verify=tls))
+
+
+def _post_text(client, route, payload, admissible):
+    """Fixed HTTPS destination and identity; redirects/retries cannot retransmit data."""
+    import httpx
+    from openai.types.chat import ChatCompletion
+
+    endpoint = httpx.URL(route[2].rstrip("/") + "/chat/completions")
+    key, organization, project = route[5]
+    headers = {"Authorization": "Bearer " + key, "Content-Type": "application/json", "Accept-Encoding": "identity"}
+    if organization:
+        headers["OpenAI-Organization"] = organization
+    if project:
+        headers["OpenAI-Project"] = project
+    request = client.build_request("POST", endpoint, json=payload)
+    if request.url != endpoint or request.method != "POST" or request.url.query:
+        _refuse()
+    if route[0] == "opencode-go" and (endpoint.scheme, endpoint.host, endpoint.port or 443) == ("https", "opencode.ai", 443):
+        from agent.opencode_affinity import opencode_session_headers
+        # Provider formatting, not authentication or native-session authority. Never
+        # inherit the parent's/ambient conversation identity (including cron scope).
+        affinity = "oneshot-" + uuid.uuid4().hex[:16]
+        approved = contextvars.Context().run(opencode_session_headers, route[0], route[2], affinity)
+        if approved != {"x-opencode-session": affinity}:
+            _refuse()
+        headers.update(approved)
+    admissible()
+    request.headers.update(headers)
+    # Auth/redirect overrides are per request; shared parent settings stay untouched.
+    response = client.send(request, auth=None, follow_redirects=False, stream=True)
+    try:
+        response.raise_for_status()
+        if response.headers.get("Content-Encoding", "").strip().lower() not in {"", "identity"}:
+            _refuse()
+        body = bytearray()
+        chunks = (response.content,) if response.is_stream_consumed else response.iter_raw()
+        for chunk in chunks:
+            admissible()
+            if len(body) + len(chunk) > 512_000:
+                _refuse()
+            body.extend(chunk)
+        return ChatCompletion.model_validate_json(body)
+    finally:
+        response.close()
+
+
+def _authorize(service, parent, request, owner):
+    from hermes_cli.config import load_config_readonly
+    from hermes_cli.plugin_capabilities import plugin_capability_granted
+    from hermes_constants import hermes_home_key
+    from openai import OpenAI
+
+    if (parent is None or not service._plugin_id
+            or owner != (service._text_profile_home, service._plugin_id)
+            or str(hermes_home_key()) != service._text_profile_home):
+        _refuse()
+    provider, model, base_url, mode, client, identity = _route(parent)
+    if (provider not in _PROVIDERS or provider != request.provider or model != request.model
+            or mode != "chat_completions" or type(client) is not OpenAI
+            or getattr(client, "_provider", None) is not None or getattr(client, "_provider_runtime", None) is not None
+            or getattr(client, "_api_key_provider", None) is not None or getattr(client, "workload_identity", None) is not None
+            or getattr(parent, "acp_command", None) or getattr(parent, "request_overrides", None)
+            or not isinstance(base_url, str) or str(client.base_url).rstrip("/") != base_url.rstrip("/")):
+        _refuse()
+    parsed = urlsplit(base_url)
+    if (parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password
+            or parsed.query or parsed.fragment or client.default_query):
+        _refuse()
+    key, organization, project = identity
+    if (type(key) is not str or not key.strip() or any(c in key for c in "\r\n")
+            or any(value is not None and (type(value) is not str or any(c in value for c in "\r\n"))
+                   for value in (organization, project))):
+        _refuse()
+    session = str(getattr(parent, "session_id", "") or "")
+    if not session or request.parent_session_id not in (None, session):
+        _refuse()
+    try:
+        snapshot = load_config_readonly()
+        if not plugin_capability_granted(service._plugin_id, "llm.text_worker", config=snapshot):
+            _refuse()
+        cfg = snapshot["plugins"]["entries"][service._plugin_id]["text_workers"]
+        route = {"provider": provider, "model": model, "base_url": base_url}
+        if cfg.get("enabled") is not True or route not in cfg.get("routes", []):
+            _refuse()
+    except (KeyError, TypeError, AttributeError):
+        _refuse()
+    current = _route(parent)
+    if request.expected_route_fingerprint not in (None, _route_fingerprint(current)):
+        _refuse()
+    return session, current
+
+
+def _route_fingerprint(route):
+    return hashlib.sha256(json.dumps(route[:4], ensure_ascii=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def authorize_text_route(service, provider, model, parent_session_id):
+    """Disclosure gate for persisted drafts; no client construction or request."""
+
+    request = _request(TextSubagentRequest(
+        goal="Validate text-worker route", provider=provider, model=model, parent_session_id=parent_session_id,
+    ))
+    if type(parent_session_id) is not str or not parent_session_id.strip():
+        _refuse()
+    _, route = _authorize(service, service._parent_agent_resolver(), request,
+                          (service._text_profile_home, service._plugin_id))
+    return _route_fingerprint(route)
+
+
+def launch_text(service, raw):
+    from agent.subagent_lifecycle import (
+        PUBLIC_CONTRACT_VERSION, SubagentHandle, SubagentState, _Record, _REGISTRY, _EXECUTOR,
+    )
+
+    request = _request(raw)
+    parent = service._parent_agent_resolver()
+    owner = (service._text_profile_home, service._plugin_id)
+    session, route = _authorize(service, parent, request, owner)
+    created = time.time()
+    deadline = time.monotonic() + request.timeout_seconds
+    ident = "text-" + uuid.uuid4().hex
+    handle = SubagentHandle(PUBLIC_CONTRACT_VERSION, ident, session, request.correlation_id, created,
+                            request.provider, request.model, "text-only", 1,
+                            service._capability(ident, session, created))
+    key = (*owner, session, request.correlation_id) if request.correlation_id else None
+    record = _Record(handle, SubagentState.PENDING, created, text_owner=owner,
+                     text_cancel=threading.Event(), correlation_key=key, text_route_fingerprint=_route_fingerprint(route))
+    # Reservation and scheduling are atomic with respect to duplicate launches.
+    with _REGISTRY.lock:
+        service._cleanup_locked()
+        if key is not None and key in _REGISTRY.correlations:
+            _refuse()
+        _REGISTRY.records[ident] = record
+        if key is not None:
+            _REGISTRY.correlations[key] = ident
+        try:
+            record.future = _EXECUTOR.submit(contextvars.copy_context().run, _run, service, record, parent, request, route, deadline)
+        except BaseException:
+            _REGISTRY.records.pop(ident, None)
+            if key is not None:
+                _REGISTRY.correlations.pop(key, None)
+            raise
+    return handle
+
+
+def _run(service, record, parent, request, route, deadline):
+    from agent.subagent_lifecycle import SubagentState, SubagentResult, _REGISTRY
+    from agent.transports.chat_completions import ChatCompletionsTransport
+    from hermes_cli.middleware import apply_llm_request_middleware, run_llm_execution_middleware
+
+    expired = threading.Event()
+    timer = threading.Timer(max(0.0, deadline - time.monotonic()), expired.set)
+    timer.daemon = True
+    timer.start()
+    attempted = 0
+    violated = False
+    response = None
+    client = None
+    error = None
+    transport_error = None
+    summary = None
+    usage = {}
+    guard = threading.Lock()
+    closed = False
+    execution_thread = threading.get_ident()
+    with _REGISTRY.lock:
+        record.started_at = record.updated_at = time.time()
+        if not record.text_cancel.is_set():
+            record.state = SubagentState.RUNNING
+
+    def admissible():
+        if record.text_cancel.is_set() or expired.is_set() or time.monotonic() >= deadline:
+            _refuse()
+        session, current = _authorize(service, parent, request, record.text_owner)
+        if current != route or session != record.handle.parent_session_id:
+            _refuse()
+
+    try:
+        admissible()
+        transport = ChatCompletionsTransport()
+        data = json.dumps({"goal": request.goal, "context": request.context}, ensure_ascii=True)
+        messages = [{"role": "system", "content": _SYSTEM}, {"role": "user", "content": data}]
+        payload = transport.build_kwargs(request.model, messages, tools=[], max_tokens=request.max_tokens,
+                                         max_tokens_param_fn=lambda value: {"max_tokens": value})
+        # Fail closed if future transport defaults expand the wire surface.
+        if (set(payload) != {"model", "messages", "max_tokens"} or payload["model"] != request.model
+                or payload["messages"] != messages or payload["max_tokens"] != request.max_tokens):
+            _refuse()
+        frozen = json.dumps(payload, sort_keys=True, allow_nan=False)
+        client = _new_http_client(float(request.timeout_seconds))
+        context = {"session_id": record.handle.parent_session_id, "task_id": record.handle.subagent_id,
+                   "plugin_id": service._plugin_id, "origin": "text_worker"}
+        prepared = apply_llm_request_middleware(copy.deepcopy(payload), **context)
+
+        def send(next_payload):
+            nonlocal attempted, violated, response, transport_error
+            with guard:
+                try:
+                    if closed or threading.get_ident() != execution_thread:
+                        _refuse()
+                    admissible()
+                    if attempted or json.dumps(next_payload, sort_keys=True, allow_nan=False) != frozen:
+                        _refuse()
+                except Exception:
+                    violated = True
+                    raise
+                attempted = 1  # record attempt before HTTP submission, even if it fails
+            try:
+                response = _post_text(client, route, copy.deepcopy(next_payload), admissible)
+            except Exception as exc:  # health: allow BLE001 -- fixed type-only transport diagnostics
+                transport_error = _transport_failure(exc)
+                raise
+            return response
+
+        observed = run_llm_execution_middleware(prepared.payload, send, original_request=copy.deepcopy(payload), strict_single_use=True, **context)
+        admissible()
+        if violated or attempted != 1 or response is None or observed is not response:
+            _refuse()
+        if response.model != request.model:
+            _refuse()
+        normalized = transport.normalize_response(response)
+        if (normalized.tool_calls or normalized.finish_reason != "stop"
+                or type(normalized.content) is not str or not normalized.content.strip()
+                or len(normalized.content) > 32000 or route[5][0] in normalized.content):
+            _refuse()
+        summary = normalized.content
+        if normalized.usage:
+            usage = dataclasses.asdict(normalized.usage)
+            if any(type(value) is not int or not 0 <= value <= 2**63 - 1 for value in usage.values()):
+                usage = {}
+                _refuse()
+    except Exception:  # health: allow BLE001 -- result boundary redacts provider/middleware exceptions that may contain credentials
+        error = transport_error or "TEXT_WORKER_FAILED"
+    finally:
+        with guard:
+            closed = True
+        timer.cancel()
+        if client is not None:
+            try:
+                client.close()
+            except Exception:  # health: allow BLE001 -- cleanup failure is redacted and cannot publish success
+                error = "TEXT_WORKER_FAILED"
+        client = None
+        route = None  # retained middleware callbacks cannot retain the credential snapshot
+    with _REGISTRY.lock:
+        cancelled = record.text_cancel.is_set()
+        timed_out = expired.is_set() or time.monotonic() >= deadline
+        state = (SubagentState.CANCELLED if cancelled else SubagentState.FAILED if error or timed_out
+                 else SubagentState.SUCCEEDED)
+        if state != SubagentState.SUCCEEDED:
+            summary = None
+        result = SubagentResult(record.handle, state, True, summary=summary, started_at=record.started_at,
+                                completed_at=time.time(), error_classification=("CANCELLED" if cancelled else
+                                "TIMEOUT" if timed_out else error), usage_metadata={"api_calls": attempted, **usage},
+                                tool_execution_summary={"tool_calls": 0})
+        digest = hashlib.sha256(json.dumps(dataclasses.asdict(result), sort_keys=True).encode()).hexdigest()
+        record.result = dataclasses.replace(result, result_hash=digest)
+        record.state, record.completed_at, record.updated_at = state, result.completed_at, result.completed_at
