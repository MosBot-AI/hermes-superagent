+def test_stream_cancellation_stops_reading_and_closes(world):
+    entered, release = threading.Event(), threading.Event()
+    class Drip(httpx.SyncByteStream):
+        closed = False
+        advanced = False
+        def __iter__(self):
+            entered.set()
+            assert release.wait(5)
+            yield b"{"
+            self.advanced = True
+            yield b"}"
+        def close(self):
+            self.closed = True
+    stream = Drip()
+    world.handler[0] = lambda req: httpx.Response(200, stream=stream)
+    handle = world.service.launch_text(request())
+    try:
+        assert entered.wait(5)
+        assert world.service.cancel(handle, reason="stop").accepted
+    finally:
+        release.set()
+    assert world.service.wait(handle, timeout_seconds=5).completed
+    assert world.service.result(handle).terminal_state == SubagentState.CANCELLED
+    assert stream.closed and not stream.advanced
