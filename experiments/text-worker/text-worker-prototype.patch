+    with pytest.raises(SubagentLifecycleError):
+        held.authorize_text_route(world.route["provider"], world.route["model"], "parent")
+    assert not world.children and not world.calls
+    monkeypatch.setenv("HERMES_HOME", str(original_home))
+    with pytest.raises(SubagentLifecycleError):
+        held.launch_text(request())  # A's consent is still revoked
