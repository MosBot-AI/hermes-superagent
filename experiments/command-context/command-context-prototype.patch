+"""Native Telegram command producer to one-call consumer contract, without network."""
+from datetime import UTC, datetime
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+import weakref
+
+import pytest
+
+from gateway.command_context import command_scope, CommandContext
+from gateway.config import Platform, PlatformConfig, GatewayConfig
+from gateway.platforms.event import MessageEvent, MessageType
+from gateway.session import SessionSource, SessionStore, build_session_key
+from gateway.session_identity import RoutingIdentity
+from hermes_cli.plugin_command_dispatch import invoke_plugin_command
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+
+def setup_ingress(tmp_path, receiver=900):
+    adapter = object.__new__(TelegramAdapter)
+    adapter.platform = Platform.TELEGRAM
+    adapter.config = PlatformConfig(enabled=True, extra={})
+    adapter._bot = SimpleNamespace(id=receiver, base_url="https://api.telegram.org/botfixture")
+    adapter._command_ingress_generation = 1
+    adapter._running = True
+    adapter._drop_delayed_deliveries = False
+    runner = SimpleNamespace(config=SimpleNamespace(profile_routes=[], multiplex_profiles=False))
+    runner._intake_adapter_for = lambda source: adapter
+    runner._session_key_for_source = build_session_key
+    runner._owning_profile = lambda adapter, platform: (True, None)
+    adapter.gateway_runner = runner
+    adapter._should_process_message = lambda *args, **kwargs: True
+    adapter._is_user_authorized_from_message = lambda message: True
+    adapter._ensure_forum_commands = AsyncMock()
+    adapter._canonicalize = lambda source: setattr(source, "_identity", RoutingIdentity(
+        "default", "default", tmp_path, tmp_path, False, weakref.ref(adapter)))
+    message = SimpleNamespace(
+        text="/probe", from_user=SimpleNamespace(id=42, is_bot=False),
+        chat=SimpleNamespace(id=42, type="private"), message_id=7,
+        message_thread_id=None, edit_date=None)
+    update = SimpleNamespace(message=message, update_id=11, edited_message=None)
+    source = SessionSource(Platform.TELEGRAM, "42", user_id="42")
+    runner.session_store = SessionStore(tmp_path / str(receiver) / "sessions", GatewayConfig())
+    entry = runner.session_store.get_or_create_session(source)
+    event = MessageEvent(text="/probe", message_type=MessageType.COMMAND, source=source,
+                         raw_message=message, message_id="7", platform_update_id=11)
+    event._test_session_id = entry.session_id
+    adapter._build_triggered_event = AsyncMock(return_value=event)
+    adapter._effective_update_message = lambda update: update.message
+    adapter.handle_message = AsyncMock()
+    return adapter, event, update
+
+
+async def receive(tmp_path, receiver=900):
+    adapter, event, update = setup_ingress(tmp_path, receiver)
+    await adapter._handle_command(update, None)
+    adapter.handle_message.assert_awaited_once_with(event)
+    return adapter, event, update
+
+
+@pytest.mark.asyncio
+async def test_two_receiving_bots_and_one_consumption(tmp_path):
+    observations = []
+    for bot_id in (900, 901):
+        _adapter, event, _ = await receive(tmp_path, bot_id)
+        with command_scope(event, event.source, build_session_key(event.source), event._test_session_id) as context:
+            assert context is not None
+            observations.append(invoke_plugin_command(lambda args, *, command_context: command_context.consume(),
+                                                       "", command_context=context))
+            assert context.consume() is None
+        with command_scope(event, event.source, build_session_key(event.source), event._test_session_id) as context:
+            assert context is None
+    assert observations[0]["actor_id"] == observations[1]["actor_id"] == "42"
+    assert [o["receiver_id"] for o in observations] == ["900", "901"]
+    assert "owner" not in observations[0]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("mutation", ["text", "actor", "internal", "disabled", "generation", "account", "route", "profile", "disconnect", "forward", "replacement", "session", "suspended", "owner", "store"])
+async def test_mutation_revokes_original_receipt(tmp_path, mutation):
+    adapter, event, update = await receive(tmp_path)
+    entry = adapter.gateway_runner.session_store.lookup_by_session_key(build_session_key(event.source))
+    mutations = {
+        "text": lambda: setattr(event, "text", event.text + " forged"),
+        "actor": lambda: setattr(event.source, "user_id", "99"),
+        "internal": lambda: setattr(event, "internal", True),
+        "disabled": lambda: setattr(event, "allow_gateway_control", False),
+        "generation": lambda: setattr(adapter, "_command_ingress_generation", 2),
+        "account": lambda: setattr(adapter._bot, "id", 901),
+        "route": lambda: adapter.gateway_runner.config.profile_routes.append("changed"),
+        "profile": lambda: setattr(event.source, "profile", "other"),
+        "disconnect": lambda: setattr(adapter, "_running", False),
+        "forward": lambda: setattr(update.message, "forward_origin", object()),
+        "session": lambda: setattr(entry, "session_id", "session-b"),
+        "suspended": lambda: setattr(entry, "suspended", True),
+        "owner": lambda: setattr(adapter.gateway_runner, "_owning_profile", lambda *args: (True, "other")),
+        "replacement": lambda: setattr(adapter.gateway_runner, "_intake_adapter_for", lambda source: object()),
+        "store": lambda: setattr(adapter.gateway_runner, "session_store", object()),
+    }
+    mutations[mutation]()
+    with command_scope(event, event.source, build_session_key(event.source), event._test_session_id) as context:
+        assert context is None
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("kind", ["bot", "group", "forward", "sender_chat", "via_bot", "edited", "endpoint", "batch", "async_reconnect"])
+async def test_unsupported_native_paths_deny(tmp_path, kind):
+    adapter, event, update = setup_ingress(tmp_path)
