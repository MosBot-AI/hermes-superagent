+        adapter._command_ingress_generation += 1
+
+    def batch():
+        event.text = "x" * adapter._SPLIT_THRESHOLD
+        adapter._enqueue_text_event = lambda event: None
+
+    mutations = {
+        "bot": lambda: setattr(update.message.from_user, "is_bot", True),
+        "group": lambda: setattr(update.message.chat, "type", "group"),
+        "forward": lambda: setattr(update.message, "forward_origin", object()),
+        "sender_chat": lambda: setattr(update.message, "sender_chat", object()),
+        "via_bot": lambda: setattr(update.message, "via_bot", object()),
+        "edited": lambda: setattr(update.message, "edit_date", datetime.now(UTC)),
+        "endpoint": lambda: adapter.config.extra.update(base_url="https://example.invalid/bot"),
+        "batch": batch,
+        "async_reconnect": lambda: setattr(adapter, "_ensure_forum_commands", reconnect),
+    }
+    mutations[kind]()
+    await adapter._handle_command(update, None)
+    with command_scope(event, event.source, build_session_key(event.source), event._test_session_id) as context:
+        assert context is None
+
+
+@pytest.mark.asyncio
+async def test_scope_exit_and_in_scope_liveness(tmp_path):
+    adapter, event, _ = await receive(tmp_path)
+    with command_scope(event, event.source, build_session_key(event.source), event._test_session_id) as context:
+        retained = context
+    assert retained.consume() is None
+    adapter, event, _ = await receive(tmp_path)
+    with command_scope(event, event.source, build_session_key(event.source), event._test_session_id) as context:
+        adapter._running = False
+        assert context.consume() is None
+    assert CommandContext().consume() is None
+
+
+@pytest.mark.asyncio
+async def test_copy_serialization_and_legacy_signature(tmp_path):
+    import copy
+    from hermes_cli.plugin_host_wire import decode, encode
+    _adapter, event, _ = await receive(tmp_path)
+    copied = copy.copy(event)
+    with command_scope(copied, copied.source, build_session_key(event.source), event._test_session_id) as context:
+        assert context is None
+    with command_scope(event, event.source, build_session_key(event.source), event._test_session_id) as context:
+        assert invoke_plugin_command(lambda args: args, "legacy", command_context=context) == "legacy"
+        restored = decode(encode(context))
+        assert not isinstance(restored, CommandContext)
+        assert "42" not in repr(context)
+        assert context.consume()["receiver_id"] == "900"
+
+
+@pytest.mark.asyncio
+async def test_real_gateway_handler_and_native_session(tmp_path):
+    from contextlib import nullcontext
+    import asyncio
+    from gateway.run_inbound_hooks import GatewayInboundHooksMixin
+    from gateway.session import AsyncSessionStore
+
+    adapter, event, update = setup_ingress(tmp_path)
+    runner = adapter.gateway_runner
+    runner.config = GatewayConfig()
+    runner.async_session_store = AsyncSessionStore(runner.session_store)
+    runner._session_env_scope = lambda context: nullcontext()
+    runner._run_in_executor_with_context = asyncio.to_thread
+    observations = []
+
+    def handler(args, *, command_context):
+        observations.append(command_context.consume() if command_context else None)
+        return "observed"
+
+    async def dispatch(event):
+        return await GatewayInboundHooksMixin._hm_run_plugin_handler(
+            runner, handler, event, event.source)
