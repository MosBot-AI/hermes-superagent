+    assert results[0]["value"]["receiver_id"] == "900"
+    assert results[0]["value"]["session_id"] == event._test_session_id
+    assert (results[0]["pid"] != os.getpid()) is (mode == "host")
+    await dispatch(event)
+    assert results[1]["value"] is None
