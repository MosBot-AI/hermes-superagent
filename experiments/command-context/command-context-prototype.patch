+"""Local prototype: native command observations across a real plugin-host process.
+
+No live credentials, network ingress or domain authorization are involved. The
+hosted process is not an isolation boundary between mutually hostile plugins.
+"""
+
+import json
+import os
+import asyncio
+from contextlib import contextmanager, nullcontext
+
+import pytest
+
+from hermes_cli.plugin_command_dispatch import invoke_plugin_command
+from hermes_cli.plugins import PluginManager
+from tests.hermes_cli.test_plugin_host import _home_with_plugins
+
+
+_PROBE = '''
+import json
+import os
+
+saved = None
+
+def register(ctx):
+    def probe(raw_args, *, command_context=None):
+        global saved
+        if raw_args == "origin-claim":
+            from hermes_cli.plugin_host_wire import serving_request
+            origin = serving_request()
+            value = ctx._runtime.channel.call("command_context_consume", {
+                "schema_version": 1, "ticket": "c" * 64})
+            legitimate = command_context.consume() if command_context is not None else None
+            return json.dumps({"pid": os.getpid(), "origin_active": isinstance(origin, int),
+                               "value": value, "legitimate": legitimate})
+        if raw_args.startswith("reverse:"):
+            value = ctx._runtime.channel.call("command_context_consume", json.loads(raw_args[8:]))
+            return json.dumps({"pid": os.getpid(), "value": value})
+        if raw_args in {"save", "raise"}:
+            saved = command_context
+            if raw_args == "raise":
+                raise RuntimeError("synthetic handler failure")
+            return json.dumps({"pid": os.getpid(), "present": command_context is not None})
+        if raw_args == "reuse":
+            value = saved.consume() if saved is not None else None
+            return json.dumps({"pid": os.getpid(), "value": value})
+        first = command_context.consume() if command_context is not None else None
+        second = command_context.consume() if command_context is not None else None
+        return json.dumps({"pid": os.getpid(), "value": first, "second": second,
+                           "representation": repr(command_context)})
+    ctx.register_command("context-probe", probe)
+    ctx.register_command("context-legacy", lambda raw_args: "legacy:" + raw_args)
+    def required(raw_args, *, command_context):
+        return "missing" if command_context is None else "present"
+    ctx.register_command("context-required", required)
+'''
+
+
+@pytest.fixture(params=["in_process", "host"])
+def command_plugin(tmp_path, monkeypatch, request):
+    _home_with_plugins(tmp_path, monkeypatch, {"context-probe": _PROBE}, isolation=request.param)
+    manager = PluginManager()
+    manager.discover_and_load()
+    try:
+        assert manager._plugins["context-probe"].error is None
+        yield manager, request.param
+    finally:
+        manager.unload()
+        host = getattr(manager, "_plugin_host_instance", None)
+        if host is not None:
+            host.shutdown()
+
+
+def _invoke(manager, raw_args="", **context):
+    handler = manager._plugin_commands["context-probe"]["handler"]
+    return json.loads(invoke_plugin_command(handler, raw_args, **context))
+
+
+@pytest.fixture
+def hosted_plugin(tmp_path, monkeypatch):
+    _home_with_plugins(tmp_path, monkeypatch, {"context-probe": _PROBE}, isolation="host")
+    manager = PluginManager()
+    manager.discover_and_load()
+    try:
+        assert manager._plugins["context-probe"].error is None
+        yield manager
+    finally:
+        manager.unload()
+        manager._plugin_host().shutdown()
+
+
+def test_missing_context_keeps_private_observation_unavailable(command_plugin):
+    manager, mode = command_plugin
+    result = _invoke(manager, "")
+    assert result["value"] is None
+    assert result["second"] is None
+    assert (result["pid"] != os.getpid()) is (mode == "host")
+
+
+def test_legacy_signature_remains_compatible(command_plugin):
+    manager, _ = command_plugin
+    handler = manager._plugin_commands["context-legacy"]["handler"]
+    assert invoke_plugin_command(handler, "unchanged", command_context=None) == "legacy:unchanged"
+
+
+def test_required_keyword_receives_explicit_unavailable_context(command_plugin):
+    manager, _ = command_plugin
+    handler = manager._plugin_commands["context-required"]["handler"]
+    assert invoke_plugin_command(handler, "", command_context=None) == "missing"
+
+
+@contextmanager
+def _synthetic_ingress(receiver_id="900001", current=lambda: True):
+    """Host-only registry fixture. Native Telegram issuance is tested separately."""
+    from gateway.command_context import _register_ingress, command_scope
+    from gateway.config import Platform
+    from gateway.platforms.event import MessageEvent
+    from gateway.session import SessionSource
+
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="123456", user_id="123456")
+    event = MessageEvent(text="/context-probe", source=source)
+    snapshot = dict(platform="telegram", issuer="telegram", actor_kind="human",
+                    provenance="native-direct-dm", actor_id="123456", chat_id="123456",
+                    receiver_id=receiver_id, transport_profile="private", runtime_profile="work",
+                    message_id="100", event_id="1000", connection_generation=1,
+                    session_key="agent:work:telegram:dm:123456", session_id="session-1")
+    _register_ingress(event, snapshot, current)
+    with command_scope(event, source, "agent:work:telegram:dm:123456", "session-1") as context:
+        yield context
+
+
+def test_observation_crosses_callback_once_and_repr_is_redacted(command_plugin):
+    manager, _ = command_plugin
+    with _synthetic_ingress() as context:
+        result = _invoke(manager, command_context=context)
+        assert result["value"]["receiver_id"] == "900001"
+        assert result["value"]["actor_id"] == "123456"
+        assert result["value"]["session_id"] == "session-1"
+        assert result["value"]["scope"] == "one-command-observation"
+        assert result["second"] is None
+        assert "900001" not in result["representation"]
+        assert "123456" not in result["representation"]
+        assert _invoke(manager, command_context=context)["value"] is None
+
+
+def test_same_actor_and_runtime_on_two_bots_preserve_receiver_distinction(command_plugin):
+    manager, _ = command_plugin
+    observations = []
+    for bot_id in ("900001", "900002"):
+        with _synthetic_ingress(bot_id) as context:
+            observations.append(_invoke(manager, command_context=context)["value"])
+    assert observations[0]["actor_id"] == observations[1]["actor_id"]
+    assert observations[0]["runtime_profile"] == observations[1]["runtime_profile"]
+    assert observations[0]["receiver_id"] != observations[1]["receiver_id"]
+    # An explicitly configured receiver comparison, not an owner-authorization decision.
+    assert [o["receiver_id"] == "900001" for o in observations] == [True, False]
+
+
+@pytest.mark.parametrize("mode", ["save", "raise"])
+def test_retained_callback_handle_expires_after_success_or_failure(command_plugin, mode):
+    manager, _ = command_plugin
+    with _synthetic_ingress() as context:
+        if mode == "raise":
+            with pytest.raises(RuntimeError, match="synthetic handler failure"):
+                _invoke(manager, mode, command_context=context)
+        else:
+            assert _invoke(manager, mode, command_context=context)["present"] is True
+    assert _invoke(manager, "reuse")["value"] is None
+
+
+def test_current_ingress_fence_is_checked_at_consumption(command_plugin):
+    manager, _ = command_plugin
+    live = [True]
+    with _synthetic_ingress(current=lambda: live[0]) as context:
+        live[0] = False
+        assert _invoke(manager, command_context=context)["value"] is None
+
+
+def test_hosted_retained_handle_expires_when_callback_returns_even_in_outer_scope(hosted_plugin):
+    with _synthetic_ingress() as context:
+        assert _invoke(hosted_plugin, "save", command_context=context)["present"] is True
+        assert _invoke(hosted_plugin, "reuse")["value"] is None
+
+
+def test_fabricated_dataclass_record_and_json_never_mint_hosted_context(hosted_plugin):
+    from gateway.command_context import CommandContext
+    from hermes_cli.plugin_host_wire import Record, decode, encode
+
+    claims = {"schema_version": 1, "receiver_id": "900001", "verified": True,
+              "ticket": "a" * 64}
+    for candidate in (claims, Record(claims), CommandContext(), decode(encode(CommandContext()))):
+        assert _invoke(hosted_plugin, command_context=candidate)["value"] is None
+
+
+@pytest.mark.parametrize("descriptor", [
+    None, {}, {"schema_version": 1},
+    {"schema_version": True, "ticket": "a" * 64},
+    {"schema_version": 0, "ticket": "a" * 64},
+    {"schema_version": 2, "ticket": "a" * 64},
+    {"schema_version": 1, "ticket": "short"},
+    {"schema_version": 1, "ticket": "a" * 64},
+    {"schema_version": 1, "ticket": "a" * 64, "owner": True},
+])
+def test_old_partial_or_unissued_dedicated_wire_descriptor_is_unavailable(hosted_plugin, descriptor):
+    from hermes_cli.plugin_host_wire import encode
+
+    handler = hosted_plugin._plugin_commands["context-probe"]["handler"]
+    host = hosted_plugin._plugin_host()
+    result = host._call("invoke_command", {
+        "ref": handler.__hermes_plugin_host_ref__, "args": [""],
+        "kwargs": encode({"command_context": {"verified": True}}),
+        "command_context": descriptor,
+    })
+    assert json.loads(result)["value"] is None
+
+
+@pytest.mark.parametrize("claim", [
+    {"schema_version": 1, "ticket": "b" * 64},
+    {"schema_version": 1, "ticket": "b" * 64, "origin": 1},
+    {"schema_version": 1, "ticket": "b" * 64, "plugin": "context-probe"},
+])
+def test_reverse_rpc_correlation_or_plugin_name_does_not_mint_ticket(hosted_plugin, claim):
+    result = _invoke(hosted_plugin, "reverse:" + json.dumps(claim))
+    assert result["pid"] != os.getpid()
+    assert result["value"] is None
+
+
+def test_active_real_reverse_rpc_origin_does_not_replace_a_valid_ticket(hosted_plugin):
+    with _synthetic_ingress() as context:
+        result = _invoke(hosted_plugin, "origin-claim", command_context=context)
+    assert result["origin_active"] is True
+    assert result["value"] is None
+    assert result["legitimate"]["receiver_id"] == "900001"
+
+
+def test_host_generation_change_fences_an_exported_ticket(hosted_plugin):
+    from hermes_cli.plugin_command_context_bridge import export_context
+
+    host = hosted_plugin._plugin_host()
+    generation = host._generation
+    with _synthetic_ingress() as context:
+        with export_context(host, context, generation) as descriptor:
+            host._generation += 1
+            try:
+                # The descriptor is valid, but belongs to the preceding host incarnation.
+                assert host._handle("command_context_consume", descriptor, 1) is None
+            finally:
+                host._generation = generation
+
