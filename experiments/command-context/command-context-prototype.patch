+@pytest.mark.asyncio
+async def test_gateway_cancellation_revokes_retained_handle(tmp_path):
+    from gateway.config import GatewayConfig
+    from gateway.run_inbound_hooks import GatewayInboundHooksMixin
+    from gateway.session import AsyncSessionStore
+    from tests.gateway.test_command_provenance import setup_ingress
+
+    adapter, _event, update = setup_ingress(tmp_path)
+    runner = adapter.gateway_runner
+    runner.config = GatewayConfig()
+    runner.async_session_store = AsyncSessionStore(runner.session_store)
+    runner._session_env_scope = lambda context: nullcontext()
+    retained, entered, wait_forever = [], asyncio.Event(), asyncio.Event()
+
+    async def handler(raw_args, *, command_context):
+        retained.append(command_context)
+        entered.set()
+        await wait_forever.wait()
+
+    async def dispatch(event):
+        return await GatewayInboundHooksMixin._hm_run_plugin_handler(
+            runner, handler, event, event.source)
+
+    adapter.handle_message = dispatch
+    task = asyncio.create_task(adapter._handle_command(update, None))
+    try:
+        await asyncio.wait_for(entered.wait(), 5)
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        assert retained[0].consume() is None
+    finally:
+        if not task.done():
+            task.cancel()
+            await asyncio.gather(task, return_exceptions=True)
