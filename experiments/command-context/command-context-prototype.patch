@@ -0,0 +1,103 @@
+"""One-call native command observations. These are NOT owner permissions.
+
+Only a certified ingress registers an event here. Records/JSON and restored session
+sources cannot register receipts. In-process plugins share the host's trust boundary;
+this module is not a Python sandbox. The isolated plugin bridge spends a host-held
+receipt, never a deserialized claim or an ambient RPC origin.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+from copy import deepcopy
+import secrets
+import threading
+import time
+import weakref
+import sqlite3
+
+_RECEIPTS = {}
+_CONTEXTS = weakref.WeakKeyDictionary()
+_LOCK = threading.RLock()
+_INGRESS_TTL = 30.0
+_HOST_INSTANCE_ID = secrets.token_hex(16)
+
+
+class CommandContext:
+    """Opaque, one-consumption observation handle; retaining it grants nothing."""
+
+    def __repr__(self):
+        return "<CommandContext: one-call native observation>"
+
+    def consume(self):
+        with _LOCK:
+            state = _CONTEXTS.pop(self, None)
+            if state is None:
+                return None
+            snapshot, current = state
+            return deepcopy(snapshot) if _current(current) else None
+
+
+def _register_ingress(event, snapshot, current):
+    """Host adapter seam, deliberately absent from plugin RPC and wire codecs."""
+    key = id(event)
+    with _LOCK:
+        _RECEIPTS[key] = (
+            weakref.ref(event, lambda ref: _discard_event(key, ref)),
+            deepcopy(snapshot), current, time.monotonic() + _INGRESS_TTL,
+        )
+
+
+def discard_ingress(event):
+    """Retire an event whose native dispatch failed or was cancelled."""
+    with _LOCK:
+        receipt = _RECEIPTS.get(id(event))
+        if receipt is not None and receipt[0]() is event:
+            _RECEIPTS.pop(id(event), None)
+
+
+def _discard_event(key, ref):
+    with _LOCK:
+        prior = _RECEIPTS.get(key)
+        if prior is not None and prior[0] is ref:
+            _RECEIPTS.pop(key, None)
+
+
+@contextmanager
+def command_scope(event, source, session_key, session_id):
+    """Spend original ingress once, and retire the observation after this dispatch."""
+    context = None
+    with _LOCK:
+        receipt = _RECEIPTS.pop(id(event), None)
+        if receipt is not None:
+            ref, snapshot, current, deadline = receipt
+            if (ref() is event and event.source is source and time.monotonic() < deadline
+                    and isinstance(session_key, str) and bool(session_key)
+                    and isinstance(session_id, str) and bool(session_id)
+                    and snapshot.get("session_key") == session_key
+                    and snapshot.get("session_id") == session_id and _current(current)):
+                context = CommandContext()
+                snapshot.update(schema_version=1, invocation_id=secrets.token_hex(16),
+                                host_instance_id=_HOST_INSTANCE_ID,
+                                session_key=session_key, session_id=session_id,
+                                scope="one-command-observation")
+                _CONTEXTS[context] = (snapshot, current)
+    try:
+        yield context
+    finally:
+        if context is not None:
+            with _LOCK:
+                _CONTEXTS.pop(context, None)
+
+
+def _is_live_context(value):
+    with _LOCK:
+        return type(value) is CommandContext and value in _CONTEXTS
+
+
+def _current(check):
+    try:
+        return check() is True
+    except (AttributeError, TypeError, ValueError, RuntimeError, OSError, sqlite3.Error):
+        # Lost or unavailable state means no observation. Never catch cancellation,
+        # and never log identity-bearing exception messages from an adapter/store.
+        return False
