+"""Command-only observations and generic callable data over real stdio pipes.
+
+No listener, bind or connect is permitted in either process. This is a
+cooperative host transport contract, not owner authorization or a sandbox.
+"""
+
+from contextlib import contextmanager
+import json
+import os
+import socket
+
+import pytest
+import hermes_yaml as yaml
+
+from hermes_cli.plugin_command_dispatch import invoke_plugin_command
+from hermes_cli.plugin_host import PluginHost
+from hermes_cli.plugins import PluginManager
+
+_GUARD = '''
+import socket
+
+def denied(*args, **kwargs):
+    raise AssertionError("socket bind/listen/connect is forbidden in this suite")
+
+for name in ("bind", "listen", "connect", "connect_ex"):
+    setattr(socket.socket, name, denied)
+socket.create_connection = denied
+socket._command_transport_test_guard = True
+'''
+
+_PLUGIN = '''
+import json
+import os
+import socket
+
+saved = None
+
+def echo(value=None, *, command_context=None):
+    if type(command_context).__name__ == "Opaque":
+        command_context = "opaque-data"
+    if hasattr(command_context, "verified"):
+        command_context = {"verified": command_context.verified}
+    return json.dumps({"pid": os.getpid(), "value": command_context,
+                       "guard": getattr(socket, "_command_transport_test_guard", False)})
+
+def command(raw_args, *, command_context=None):
+    global saved
+    if raw_args == "save" or raw_args == "raise":
+        saved = command_context
+        if raw_args == "raise":
+            raise RuntimeError("fixture failure")
+        return "saved"
+    if raw_args == "reuse":
+        return json.dumps(saved.consume() if saved is not None else None)
+    return json.dumps({"pid": os.getpid(),
+        "value": command_context.consume() if command_context is not None else None,
+        "second": command_context.consume() if command_context is not None else None})
+
+async def async_command(raw_args, *, command_context=None):
+    return command(raw_args, command_context=command_context)
+
+def register(ctx):
+    ctx.register_command("observe-context", command)
+    ctx.register_command(name="observe-async", handler=async_command)
+    ctx.register_command("observe-legacy", lambda raw_args: raw_args)
+    ctx.register_hook("post_tool_call", echo)
+    ctx.register_tool(name="context-echo", toolset="context-echo",
+        schema={"name": "context-echo", "description": "Echo ordinary data",
+                "parameters": {"type": "object", "properties": {}}}, handler=echo)
+'''
+
+
+@pytest.fixture(autouse=True)
+def no_socket_transport(tmp_path, monkeypatch):
+    def denied(*args, **kwargs):
+        raise AssertionError("socket bind/listen/connect is forbidden in this suite")
+
+    for name in ("bind", "listen", "connect", "connect_ex"):
+        monkeypatch.setattr(socket.socket, name, denied)
+    monkeypatch.setattr(socket, "create_connection", denied)
+    # Keep the production argv/entry point. sitecustomize guards child startup
+    # before application imports, without changing the real stdio transport.
+    guard_dir = tmp_path / "socket-guard"
+    guard_dir.mkdir()
+    (guard_dir / "sitecustomize.py").write_text(_GUARD)
+    original_env = PluginHost._env
+
+    def guarded_env(host):
+        env = original_env(host)
+        env["PYTHONPATH"] = os.pathsep.join((str(guard_dir), env.get("PYTHONPATH", "")))
+        return env
+
+    monkeypatch.setattr(PluginHost, "_env", guarded_env)
+
+
+@pytest.fixture
+def plugin(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    directory = home / "plugins" / "context-fixture"
+    directory.mkdir(parents=True)
+    (directory / "plugin.yaml").write_text("name: context-fixture\nversion: '1.0'\n")
+    (directory / "__init__.py").write_text(_PLUGIN)
+    (home / "config.yaml").write_text(yaml.safe_dump({
+        "plugins": {"enabled": ["context-fixture"], "isolation": "host"}}))
+    bundled = tmp_path / "bundled"
+    bundled.mkdir()
+    from hermes_cli import plugins
+    monkeypatch.setenv("HOME", str(tmp_path / "os-home"))
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(plugins, "get_bundled_plugins_dir", lambda: bundled)
+    manager = PluginManager()
+    try:
+        manager.discover_and_load()
+        assert manager._plugins["context-fixture"].error is None
+        probe = json.loads(manager._hooks["post_tool_call"][0]())
+        assert probe["guard"] is True
+        assert probe["pid"] != os.getpid()
+        yield manager
+    finally:
+        manager.unload()
+        host = getattr(manager, "_plugin_host_instance", None)
+        if host is not None:
+            host.shutdown()
+
+
+@contextmanager
+def observation(current=lambda: True):
+    from gateway.command_context import _register_ingress, command_scope
+    from gateway.config import Platform
+    from gateway.platforms.event import MessageEvent
+    from gateway.session import SessionSource
+
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="123", user_id="123")
+    event = MessageEvent(text="/observe-context", source=source)
+    snapshot = {"session_key": "fixture-session", "session_id": "fixture-id",
+                "receiver_id": "receiver-one", "actor_id": "123"}
+    _register_ingress(event, snapshot, current)
+    with command_scope(event, source, "fixture-session", "fixture-id") as context:
+        yield context
+
+
+def handler(manager, name="observe-context"):
+    return manager._plugin_commands[name]["handler"]
+
+
+@pytest.mark.parametrize("value", [None, "ordinary-data", {"verified": True, "ticket": "a" * 64}])
+def test_generic_hook_and_tool_keep_command_context_data(plugin, value):
+    from tools.registry import registry
+    hook = plugin._hooks["post_tool_call"][0]
+    hook_result = json.loads(hook(command_context=value))
+    tool_result = json.loads(registry.dispatch("context-echo", {}, scope=plugin.scope_key,
+                                               command_context=value))
+    for result in (hook_result, tool_result):
+        assert result["value"] == value
+        assert result["pid"] != os.getpid()
+
+
+def test_generic_record_keeps_fields_without_granting_authority(plugin):
+    from hermes_cli.plugin_host_wire import Record
+    result = json.loads(plugin._hooks["post_tool_call"][0](command_context=Record({"verified": True})))
+    assert result["value"] == {"verified": True}
+
+
+def test_native_registration_exports_once_and_generic_call_cannot_consume(plugin):
+    hook = plugin._hooks["post_tool_call"][0]
+    with observation() as context:
+        # Generic serialization of the opaque context carries no live handle.
+        generic = hook(command_context=context)
+        assert json.loads(generic)["value"] == "opaque-data"
+        result = json.loads(invoke_plugin_command(handler(plugin), "", command_context=context))
+        assert result["value"]["receiver_id"] == "receiver-one"
+        assert result["value"]["scope"] == "one-command-observation"
+        assert result["second"] is None
+        assert json.loads(invoke_plugin_command(handler(plugin), "", command_context=context))["value"] is None
+    assert invoke_plugin_command(handler(plugin, "observe-legacy"), "legacy", command_context=None) == "legacy"
+
+
+@pytest.mark.parametrize("claim_kind", ["json", "record", "unissued", "roundtrip"])
+def test_command_claims_are_unavailable(plugin, claim_kind):
+    from gateway.command_context import CommandContext
+    from hermes_cli.plugin_host_wire import Record, decode, encode
+    claim = {"json": {"verified": True, "ticket": "a" * 64},
+             "record": Record({"verified": True}), "unissued": CommandContext(),
+             "roundtrip": decode(encode(CommandContext()))}[claim_kind]
+    result = json.loads(invoke_plugin_command(handler(plugin), "", command_context=claim))
+    assert result["value"] is None
+    assert result["second"] is None
+
+
+@pytest.mark.parametrize("mode", ["save", "raise"])
+def test_callback_exit_revokes_ticket_inside_outer_scope(plugin, mode):
+    host = plugin._plugin_host()
+    with observation() as context:
+        if mode == "raise":
+            with pytest.raises(RuntimeError, match="fixture failure"):
+                invoke_plugin_command(handler(plugin), mode, command_context=context)
+        else:
+            assert invoke_plugin_command(handler(plugin), mode, command_context=context) == "saved"
+        assert json.loads(invoke_plugin_command(handler(plugin), "reuse")) is None
+        assert not host._command_context_tickets
+
+
+@pytest.mark.asyncio
+async def test_keyword_registered_async_command_receives_observation(plugin):
+    with observation() as context:
+        result = json.loads(await invoke_plugin_command(
+            handler(plugin, "observe-async"), "", command_context=context))
+        assert result["value"]["receiver_id"] == "receiver-one"
+        assert result["second"] is None
+
+
+def test_current_fence_and_generation_remain_fail_closed(plugin):
+    from hermes_cli.plugin_command_context_bridge import export_context, consume_context
+    live = [True]
+    with observation(lambda: live[0]) as context:
+        live[0] = False
+        assert json.loads(invoke_plugin_command(handler(plugin), "", command_context=context))["value"] is None
+    host = plugin._plugin_host()
+    with observation() as context:
+        with export_context(host, context, host._generation) as descriptor:
+            host._generation += 1
+            try:
+                assert consume_context(host, descriptor) is None
+            finally:
+                host._generation -= 1
+        assert not host._command_context_tickets
+
+
+def test_command_operation_does_not_trust_generic_kwargs_or_unissued_descriptor(plugin):
+    from hermes_cli.plugin_host_wire import encode
+    host = plugin._plugin_host()
+    result = host._call("invoke_command", {
