+
+def test_generic_operation_ignores_top_level_descriptor(plugin):
+    from hermes_cli.plugin_command_context_bridge import export_context
+    host = plugin._plugin_host()
+    hook = plugin._hooks["post_tool_call"][0]
+    with observation() as context:
+        with export_context(host, context, host._generation) as descriptor:
+            result = host._call("invoke", {
+                "ref": hook.__hermes_plugin_host_ref__, "args": [],
+                "kwargs": {"command_context": {"verified": True}},
+                "command_context": descriptor,
+            })
+            assert json.loads(result)["value"] == {"verified": True}
+            assert context.consume()["receiver_id"] == "receiver-one"
+
+
+def test_released_command_reference_cleans_up_export(plugin):
+    host = plugin._plugin_host()
+    command = handler(plugin)
+    host._call("release", {"refs": [command.__hermes_plugin_host_ref__]})
+    with observation() as context:
+        with pytest.raises(LookupError, match="was released"):
+            invoke_plugin_command(command, "", command_context=context)
+        assert not host._command_context_tickets
+
+
+def test_expired_ingress_is_not_refreshed_by_command_transport(plugin, monkeypatch):
+    from gateway import command_context
+    original = command_context.time.monotonic
+    # Expire the original receipt before entering command_scope, without sleeping.
+    times = iter((100.0, 131.0))
+    monkeypatch.setattr(command_context.time, "monotonic", lambda: next(times, original()))
+    with observation() as context:
+        assert context is None
+        result = json.loads(invoke_plugin_command(handler(plugin), "", command_context=context))
+        assert result["value"] is None
