diff --git a/plugins/platforms/telegram/telegram_command_context.py b/plugins/platforms/telegram/telegram_command_context.py
new file mode 100644
index 0000000000000000000000000000000000000000..7b9b4317f716f245fce89e40b139ded2481a1565
--- /dev/null
+++ b/plugins/platforms/telegram/telegram_command_context.py
@@ -0,0 +1,164 @@
+"""Certified Telegram immediate, human DM command ingress only.
+
+PTB's authenticated polling/application dispatch is the trust boundary. This is not
+an authentication service for callers constructing Update objects in this process.
+Unsupported inputs and transformed/batched events receive no observation handle.
+"""
+from copy import deepcopy
+from functools import wraps
+import logging
+import weakref
+import sqlite3
+from urllib.parse import urlsplit
+
+from gateway.command_context import _register_ingress
+from gateway.session_identity import identity_of
+
+
+logger = logging.getLogger(__name__)
+
+
+def _optional_observation(function):
+    @wraps(function)
+    def guarded(*args, **kwargs):
+        try:
+            return function(*args, **kwargs)
+        except (AttributeError, TypeError, ValueError, RuntimeError, OSError, sqlite3.Error):
+            # Optional evidence must not break ordinary commands, nor log SDK objects,
+            # URLs (which contain tokens), account IDs, or exception payloads.
+            logger.debug("Native command observation unavailable")
+            return None
+    return guarded
+
+
+def _native_fields(message):
+    user = getattr(message, "from_user", None)
+    chat = getattr(message, "chat", None)
+    return (
+        getattr(user, "id", None), getattr(user, "is_bot", None),
+        getattr(chat, "id", None), getattr(chat, "type", None),
+        getattr(message, "message_id", None), getattr(message, "text", None),
+        getattr(message, "message_thread_id", None),
+        bool(getattr(message, "forward_origin", None)),
+        bool(getattr(message, "forward_date", None)),
+        bool(getattr(message, "sender_chat", None)),
+        bool(getattr(message, "via_bot", None)),
+        bool(getattr(message, "edit_date", None)),
+    )
+
+
+def _connection(adapter):
+    bot = getattr(adapter, "_bot", None)
+    return (id(bot), getattr(bot, "id", None), getattr(adapter, "_command_ingress_generation", None))
+
+
+def _official_endpoint(adapter):
+    url = getattr(getattr(adapter, "_bot", None), "base_url", "")
+    if not isinstance(url, str):
+        return False
+    parsed = urlsplit(url)
+    return (parsed.scheme == "https" and parsed.netloc == "api.telegram.org"
+            and parsed.path.startswith("/bot") and not parsed.query and not parsed.fragment)
+
+
+@_optional_observation
+def capture_native_command(adapter, update, message):
+    """Capture before any await; receiver comes from the connected SDK bot, not input."""
+    if (not _official_endpoint(adapter) or adapter.config.extra.get("base_url") or adapter.config.extra.get("base_file_url")
+            or getattr(message, "edit_date", None) is not None
+            or getattr(update, "edited_message", None) is not None):
+        return None
+    fields = _native_fields(message)
+    connection = _connection(adapter)
+    if (getattr(update, "message", None) is not message or fields[3] != "private"
+            or type(fields[0]) is not int or fields[1] is not False
+            or fields[0] <= 0 or fields[0] != fields[2] or any(fields[7:])
+            or type(fields[4]) is not int or fields[4] <= 0
+            or type(getattr(update, "update_id", None)) is not int
+            or fields[6] is not None or type(connection[1]) is not int
+            or connection[2] is None or getattr(adapter, "_running", False) is not True):
+        return None
+    return fields, connection, getattr(update, "update_id", None)
+
+
+@_optional_observation
+def register_native_command(adapter, event, update, captured):
+    """Tie the original event to current routing and connection, without wire flags."""
+    if captured is None:
+        return
+    fields, connection, update_id = captured
+    message = event.raw_message
+    if _native_fields(message) != fields or _connection(adapter) != connection:
+        return
+    # The canonical routing seam is the only authority for runtime/transport profile.
+    adapter._canonicalize(event.source)
+    identity = identity_of(event.source)
+    runner = getattr(adapter, "gateway_runner", None)
+    if identity is None or identity.adapter() is not adapter or runner is None:
+        return
+    ownership = runner._owning_profile(adapter, event.source.platform)
+    if not ownership[0]:
+        return
+    routes = deepcopy(runner.config.profile_routes)
+    homes = deepcopy(getattr(runner.config, "_runtime_profile_homes", None))
+    primary = getattr(runner, "_primary_profile_name", None)
+    profile = event.source.profile
+    multiplexed = runner.config.multiplex_profiles
+    source = event.source
+    source_fields = (source.platform, source.user_id, source.chat_id, source.chat_type, source.thread_id)
+    if (source.platform.value != "telegram" or source.user_id != str(fields[0])
+            or source.chat_id != str(fields[2]) or source.chat_type != "dm"
+            or event.text != fields[5] or not event.allow_gateway_control or event.internal):
+        return
+    session_key = runner._session_key_for_source(source)
+    store = getattr(runner, "session_store", None)
+    if store is None:
+        return
+    entry = store.lookup_by_session_key(session_key)
+    if entry is None or not entry.session_id or entry.suspended or entry.expiry_finalized:
+        return
+    session_id = entry.session_id
+    event_ref, adapter_ref = weakref.ref(event), weakref.ref(adapter)
+    text, message_id, message_type = event.text, event.message_id, event.message_type
+
+    def current():
+        live, receiver = event_ref(), adapter_ref()
+        if live is None or receiver is None:
+            return False
+        src = live.source
+        return (
+            receiver._running is True and _connection(receiver) == connection
+            and not receiver._should_drop_delayed_delivery()
+            and live.raw_message is message and _native_fields(message) == fields
+            and live.text == text and live.message_id == message_id and live.message_type == message_type
+            and live.platform_update_id == update_id
+            and live.allow_gateway_control is True and not live.internal
+            and src is source and identity_of(src) is identity
+            and identity.adapter() is receiver
+            and (src.platform, src.user_id, src.chat_id, src.chat_type, src.thread_id) == source_fields
+            and not src.is_bot and not src.delivered_via_upstream_relay
+            and not src.profile_route_rejected
+            and src.profile == profile
+            and runner.config.multiplex_profiles == multiplexed
+            and runner.config.profile_routes == routes
+            and getattr(runner.config, "_runtime_profile_homes", None) == homes
+            and getattr(runner, "_primary_profile_name", None) == primary
+            and runner._owning_profile(receiver, src.platform) == ownership
+            and runner.session_store is store
+            and store.lookup_by_session_key(session_key) is entry
+            and entry.session_id == session_id and not entry.suspended and not entry.expiry_finalized
+            and _official_endpoint(receiver)
+            and not receiver.config.extra.get("base_url")
