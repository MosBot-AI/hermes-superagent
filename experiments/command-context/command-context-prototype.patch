index 0000000000000000000000000000000000000000..58b99407d420334e60e5d4c6e53ef4f91c0ea0f6
--- /dev/null
+++ b/hermes_cli/plugin_command_context_bridge.py
@@ -0,0 +1,70 @@
+"""Dedicated one-call observation bridge; ordinary Record decoding grants nothing.
+
+Tickets are random, host-owned and expire when invoke returns, fails or times out.
+The channel is a per-profile cooperative plugin boundary, NOT per-plugin isolation.
+No reverse RPC uses these observations as authorization for host actions.
+"""
+from contextlib import contextmanager
+import secrets
+import threading
+
+from gateway.command_context import _is_live_context
+
+_LOCK = threading.RLock()
+
+
+@contextmanager
+def export_context(host, value, generation):
+    descriptor = None
+    ticket = None
+    if _is_live_context(value) and generation == host._generation:
+        ticket = secrets.token_hex(32)
+        with _LOCK:
+            if not hasattr(host, "_command_context_tickets"):
+                host._command_context_tickets = {}
+            host._command_context_tickets[ticket] = (generation, value)
+        descriptor = {"schema_version": 1, "ticket": ticket}
+    try:
+        yield descriptor
+    finally:
+        if ticket is not None:
+            with _LOCK:
+                host._command_context_tickets.pop(ticket, None)
+
+
+def consume_context(host, params):
+    if set(params) != {"schema_version", "ticket"} or type(params["schema_version"]) is not int or params["schema_version"] != 1:
+        return None
+    ticket = params["ticket"]
+    if not isinstance(ticket, str):
+        return None
+    with _LOCK:
+        state = getattr(host, "_command_context_tickets", {}).pop(ticket, None)
+        if state is None or state[0] != host._generation:
+            return None
+        return state[1].consume()
+
+
+class RemoteCommandContext:
+    """Constructed only by the incoming invoke seam, never by decode/restore."""
+
+    def __init__(self, channel, descriptor):
+        self._channel = channel
+        self._descriptor = descriptor
+
+    def __repr__(self):
+        return "<RemoteCommandContext: one-call native observation>"
+
+    def consume(self):
+        descriptor, self._descriptor = self._descriptor, None
+        if descriptor is None:
+            return None
+        return self._channel.call("command_context_consume", descriptor)
+
+
+def import_context(channel, descriptor):
+    if (not isinstance(descriptor, dict) or set(descriptor) != {"schema_version", "ticket"}
+            or type(descriptor["schema_version"]) is not int or descriptor["schema_version"] != 1
+            or not isinstance(descriptor["ticket"], str) or len(descriptor["ticket"]) != 64):
+        return None
+    return RemoteCommandContext(channel, descriptor)
