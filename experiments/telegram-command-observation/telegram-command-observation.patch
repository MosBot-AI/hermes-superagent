+    def _direct_command_transport(self) -> tuple[object, int | None] | None:
+        """Sample the active connection and native polling generation for a command."""
+        connection = self._direct_command_connection
+        if connection is None or not self._running or self._teardown_started:
+            return None
+        if self._webhook_mode:
+            return connection, None
+        if not self._polling_progress_accepting:
+            return None
+        return connection, self._polling_generation
+
+    def _stamp_direct_command(self, update: Update, event: MessageEvent) -> None:
+        """Keep original SDK provenance on the immediate event only."""
+        transport = self._direct_command_transport()
+        if transport is None or not TELEGRAM_AVAILABLE or type(update) is not Update:
+            return
+        message = event.raw_message
+        if type(message) is not Message or update.message is not message:
+            return
+        user = message.from_user
+        if user is None or any(
+            (
+                message.chat.type != "private",
+                user.is_bot is not False,
+                type(user.id) is not int,
+                type(message.chat.id) is not int,
+                message.chat.id != user.id,
+                message.edit_date is not None,
+                message.forward_origin is not None,
+                message.is_automatic_forward,
+                message.sender_chat is not None,
+                message.via_bot is not None,
+                message.business_connection_id is not None,
+                message.sender_business_bot is not None,
+                message.is_from_offline,
+                message.is_topic_message,
+                message.message_thread_id is not None,
+            )
+        ):
+            return
+        bot = self._bot
+        if not isinstance(bot, Bot):
+            return
+        try:
+            if update.get_bot() is not bot or message.get_bot() is not bot:
+                return
+            receiver = bot.id
+        except RuntimeError:
+            return  # No initialized SDK receiving account.
+        if type(receiver) is not int or min(receiver, user.id) <= 0:
+            return
+        event._telegram_direct_command = (
+            weakref.ref(event), weakref.ref(self), message, event.text,
+            user.id, receiver, time.monotonic(), transport,
+        )
+
     async def _handle_location_message(self, update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
         """Handle incoming location/venue pin messages."""
