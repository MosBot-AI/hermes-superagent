diff --git a/gateway/run_telegram_command_observation.py b/gateway/run_telegram_command_observation.py
new file mode 100644
index 0000000000..675e68eada
--- /dev/null
+++ b/gateway/run_telegram_command_observation.py
@@ -0,0 +1,122 @@
+"""Command-local Telegram transport observations for in-process callbacks."""
+
+from __future__ import annotations
+
+import inspect
+from dataclasses import dataclass
+from threading import Lock
+from time import monotonic
+
+from gateway.config import Platform
+from gateway.session_identity import identity_of
+
+_MAX_AGE_SECONDS = 5.0
+
+
+@dataclass(frozen=True)
+class TelegramCommandObservation:
+    actor_id: int
+    receiver_id: int
+    profile: str
+    command: str
+
+
+class _ObservationHandle:
+    """One read while the registered callback is running."""
+
+    def __init__(self, read):
+        self._read = read
+        self._lock = Lock()
+
+    def __call__(self):
+        with self._lock:
+            read, self._read = self._read, None
+            return read() if read is not None else None
+
+    def close(self):
+        with self._lock:
+            self._read = None
+
+
+def _declares_observation(handler) -> bool:
+    if getattr(handler, "__hermes_plugin_host_ref__", None) is not None:
+        return False
+    try:
+        parameters = list(inspect.signature(handler, follow_wrapped=False).parameters.values())
+    except (ValueError, TypeError):
+        return False
+    # The first positional slot belongs to raw_args, including when it uses this name.
+    return any(
+        parameter.name == "telegram_observation"
+        and (
+            parameter.kind is inspect.Parameter.KEYWORD_ONLY
+            or (index > 0 and parameter.kind is inspect.Parameter.POSITIONAL_OR_KEYWORD)
+        )
+        for index, parameter in enumerate(parameters)
+    )
+
+
+def open_observation(runner, handler, event, source, registered_name):
+    """Bind the adapter's original event to one explicitly named command input."""
+    if registered_name is None or source.platform is not Platform.TELEGRAM:
+        return None
+    stamp = vars(event).pop("_telegram_direct_command", None)
+    if stamp is None or not _declares_observation(handler):
+        return None
+    event_ref, adapter_ref, original, text, actor, receiver, captured, transport = stamp
+    command = event.get_command()
+    if event_ref() is not event or command is None or command.replace("_", "-") != registered_name:
+        return None
+    identity = identity_of(source)
+    if identity is None or identity.runtime_profile != identity.transport_profile:
+        return None
+    registered = runner._transport_owner(source)
+    adapter = adapter_ref()
+    if (
+        adapter is None
+        or registered is None
+        or registered[0] is not adapter
+        or adapter._direct_command_transport() != transport
+    ):
+        return None
+
+    def read():
+        adapter = adapter_ref()
+        if any(
+            (
+                not 0 <= monotonic() - captured < _MAX_AGE_SECONDS,
+                runner._draining,
+                identity_of(source) is not identity,
+                source is not event.source,
+                event.raw_message is not original,
+                event.text != text,
+                event.edit_revision is not None,
+                event.internal,
+                source.chat_type != "dm",
+                source.thread_id is not None,
+                source.is_bot,
+                not source.user_id == source.chat_id == str(actor),
+                getattr(source, "delivered_via_upstream_relay", False),
+                getattr(source, "profile_route_rejected", False),
+            )
+        ):
+            return None
+        if adapter is None or adapter.gateway_runner is not runner or identity.adapter() is not adapter:
+            return None
+        if runner._transport_owner(source) != registered:
+            return None
+        bot = adapter._bot
+        if bot is None:
+            return None
+        try:
+            if original.get_bot() is not bot or bot.id != receiver:
+                return None
+        except RuntimeError:
+            return None
+        if not runner._is_user_authorized_for_source(source):
+            return None
+        if adapter._direct_command_transport() != transport:
+            return None
+        return TelegramCommandObservation(actor, receiver, identity.transport_profile, registered_name)
+
+    return _ObservationHandle(read)
