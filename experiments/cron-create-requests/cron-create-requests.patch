@@ -0,0 +1,209 @@
+"""Review-only, profile-local exact create requests. Not identity or delivery authority.
+
+All old runtimes must be stopped before adopting this envelope. Native execution,
+occurrence and delivery ownership is unchanged. No external provider reconciliation.
+"""
+
+import copy
+import hashlib
+import inspect
+import json
+import re
+import uuid
+from contextvars import ContextVar
+
+MAX_REQUESTS = 1024
+MAX_STORE_BYTES = 16 * 1024 * 1024
+MAX_ARGUMENT_BYTES = 65536
+_PENDING = ContextVar("cron_pending_create", default=None)
+
+
+class CreateRequestError(ValueError):
+    pass
+
+
+def _pairs(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise CreateRequestError("create_request_store_corrupt")
+        result[key] = value
+    return result
+
+
+def _constant(_value):
+    raise CreateRequestError("create_request_store_corrupt")
+
+
+def read_ledger(path):
+    if not path.exists():
+        return {}
+    # Bounded read; never salvage malformed JSON then silently lose tombstones.
+    with path.open("rb") as stream:
+        raw = stream.read(MAX_STORE_BYTES + 1)
+    if len(raw) > MAX_STORE_BYTES:
+        raise CreateRequestError("create_request_store_too_large")
+    try:
+        data = json.loads(raw, object_pairs_hook=_pairs, parse_constant=_constant)
+    except (ValueError, UnicodeError):
+        raise CreateRequestError("create_request_store_corrupt") from None
+    if not isinstance(data, dict):
+        return {}
+    if "create_requests" not in data:
+        if "create_request_version" in data:
+            raise CreateRequestError("create_request_store_corrupt")
+        return {}
+    ledger = data["create_requests"]
+    if (
+        type(data.get("create_request_version")) is not int
+        or data.get("create_request_version") != 1
+        or type(ledger) is not dict
+        or len(ledger) > MAX_REQUESTS
+        or type(data.get("jobs")) is not list
+    ):
+        raise CreateRequestError("create_request_store_corrupt")
+    ids = set()
+    for key, row in ledger.items():
+        if (
+            not re.fullmatch(r"[A-Za-z0-9_.:-]{1,128}", key)
+            or type(row) is not dict
+            or set(row) != {"digest", "job_id", "state"}
+            or type(row["digest"]) is not str
+            or not re.fullmatch(r"[a-f0-9]{64}", row["digest"])
+            or type(row["job_id"]) is not str
+            or not re.fullmatch(r"[a-f0-9]{12}", row["job_id"])
+            or row["state"] not in ("present", "removed")
+            or row["job_id"] in ids
+        ):
+            raise CreateRequestError("create_request_store_corrupt")
+        ids.add(row["job_id"])
+        matches = [
+            j for j in data["jobs"] if type(j) is dict and j.get("id") == row["job_id"]
+        ]
+        if len(matches) != (1 if row["state"] == "present" else 0):
+            raise CreateRequestError("create_request_store_corrupt")
+    return ledger
+
+
+def pending_job_id():
+    pending = _PENDING.get()
+    return pending[1]["job_id"] if pending else None
+
+
+def store_envelope(path, jobs):
+    ledger = copy.deepcopy(read_ledger(path))
+    pending = _PENDING.get()
+    if pending:
+        key, row = pending
+        if key in ledger and ledger[key] != row:
+            raise CreateRequestError("create_request_conflict")
+        ledger[key] = dict(row)
+    ids = {job.get("id") for job in jobs}
+    for row in ledger.values():
+        if row["state"] == "removed" and row["job_id"] in ids:
+            raise CreateRequestError("create_request_removed")
+        if row["job_id"] not in ids:
+            row["state"] = "removed"
+    result = {"jobs": jobs}
+    if ledger:
+        result.update(create_request_version=1, create_requests=ledger)
+    if len(json.dumps(result, ensure_ascii=False).encode()) > MAX_STORE_BYTES - 1024:
+        raise CreateRequestError("create_request_store_too_large")
+    return result
+
+
+def _arguments(kwargs, create):
+    try:
+        bound = inspect.signature(create).bind(**kwargs)
+        bound.apply_defaults()
+
+        # Strict JSON types: no objects with user-defined serialization or NaN.
+        def check(value):
+            if value is None or type(value) in (str, bool, int):
+                return
+            if type(value) is list:
+                for item in value:
+                    check(item)
+                return
+            if type(value) is dict and all(type(k) is str for k in value):
+                for item in value.values():
+                    check(item)
+                return
+            raise ValueError
+
+        check(bound.arguments)
+        payload = json.dumps(
+            bound.arguments,
+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=False,
+            allow_nan=False,
+        ).encode()
+        if len(payload) > MAX_ARGUMENT_BYTES:
+            raise ValueError
+    except (ValueError, TypeError, RecursionError):
+        raise CreateRequestError("invalid_create_request") from None
+    return hashlib.sha256(b"cron-create-v1\0" + payload).hexdigest(), copy.deepcopy(
+        bound.arguments
+    )
+
+
+def create_once(*, request_key, **kwargs):
+    from cron import jobs
+
+    if type(request_key) is not str or not re.fullmatch(
+        r"[A-Za-z0-9_.:-]{1,128}", request_key
+    ):
+        raise CreateRequestError("invalid_request_key")
+    # No external registration call: its success/timeout cannot safely be replayed.
+    from hermes_cli.config import cfg_get, load_config
+
+    try:
+        configured = cfg_get(load_config(), "cron", "provider", default="builtin")
+    except Exception:
+        raise CreateRequestError("keyed_create_provider_unavailable") from None
+    if configured not in ("builtin", "", None):
+        raise CreateRequestError("keyed_create_provider_unsupported")
+    # Do not resolve a provider: a second config read could load external code
+    # and silently fall back. This snapshot admits builtin store ownership only.
+    digest, arguments = _arguments(kwargs, jobs.create_job)
+    with jobs._jobs_lock():
+        ledger = read_ledger(jobs._current_cron_store().jobs_file)
+        existing_jobs = (
+            jobs.load_jobs()
+        )  # Any legacy repair precedes the pending binding.
+        row = ledger.get(request_key)
+        replayed = row is not None
+        if row:
+            if row["digest"] != digest:
+                raise CreateRequestError("create_request_conflict")
+        else:
+            if len(ledger) >= MAX_REQUESTS:
+                raise CreateRequestError("create_request_capacity")
+            row = {
+                "digest": digest,
+                "job_id": uuid.uuid4().hex[:12],
+                "state": "present",
+            }
+            if any(j.get("id") == row["job_id"] for j in existing_jobs):
+                raise CreateRequestError("create_request_identifier_collision")
+            token = _PENDING.set((request_key, row))
+            try:
+                jobs.create_job(**arguments)
+            except (OSError, RuntimeError):
+                # The atomic replacement may already have committed. Same-key retry is safe.
+                raise CreateRequestError("create_outcome_unknown") from None
+            finally:
+                _PENDING.reset(token)
+        current = next(
+            (j for j in jobs.load_jobs() if j.get("id") == row["job_id"]), None
+        )
+        # Builtin registration is a no-op; never reset scheduling state on replay.
+        return {
+            "creation": dict(row),
+            "current_job": copy.deepcopy(current),
+            "replayed": replayed,
+            "registration": "builtin_store_owned",
+            "enabled": bool(current and current.get("enabled")),
+            "delivery_verified": False,
+        }
