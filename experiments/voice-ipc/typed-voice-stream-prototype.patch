diff --git a/hermes_cli/plugin_host_voice.py b/hermes_cli/plugin_host_voice.py
new file mode 100644
index 00000000..9e96ebac
--- /dev/null
+++ b/hermes_cli/plugin_host_voice.py
@@ -0,0 +1,314 @@
+"""Typed, bounded voice sessions over the existing per-profile plugin-host pipe.
+
+Closing fences replies immediately. It cannot interrupt Python/provider compute; busy
+entries retain their capacity reservation until that compute returns and cleanup runs.
+"""
+from __future__ import annotations
+
+import logging
+import contextvars
+import threading
+import time
+import uuid
+import weakref
+from collections.abc import Iterator
+
+from agent.transcription_provider import TranscriptionProvider, TranscriptionStreamSession
+from agent.tts_provider import TTSProvider
+from hermes_cli.plugin_host_wire import decode, encode
+
+MAX_SESSIONS = 32
+MAX_CHUNK = 1024 * 1024
+MAX_AUDIO = 32 * 1024 * 1024
+MAX_TEXT = 64 * 1024
+CALL_TIMEOUT = 120.0
+CLOSE_TIMEOUT = 2.0
+logger = logging.getLogger("hermes_cli.plugins")
+
+
+def voice_kind(base, method):
+    if issubclass(base, TranscriptionProvider) and method == "open_stream_session":
+        return "asr"
+    if issubclass(base, TTSProvider) and method == "stream":
+        return "tts"
+    return None
+
+
+def bounded_text(value):
+    if not isinstance(value, str) or len(value.encode("utf-8")) > MAX_TEXT:
+        raise ValueError("voice text must be a string of at most 64 KiB")
+    return value
+
+
+def validate_input(args, kwargs):
+    # Voice open has text/options only, never arbitrary live handles or unbounded trees.
+    import json
+    data = json.dumps([args, kwargs], ensure_ascii=False)
+    if len(data.encode("utf-8")) > MAX_TEXT:
+        raise ValueError("voice open arguments exceed 64 KiB")
+
+
+class _Entry:
+    def __init__(self, owner, plugin, kind):
+        self.owner, self.plugin, self.kind = owner, plugin, kind
+        self.value = None
+        self.busy = True
+        self.closed = False
+        self.total = 0
+
+
+class VoiceSessions:
+    """Child-owned sessions; only the two declared provider entry points can create one."""
+    def __init__(self, runtime):
+        self.runtime = runtime
+        self.entries = {}
+        self.retired_owners = set()
+        self.lock = threading.Lock()
+
+    def open(self, params):
+        owner, token = int(params["ref"]), str(params["token"])
+        obj = self.runtime.refs.get(owner)
+        method = str(params["method"])
+        kind = voice_kind(type(obj), method)
+        if kind is None:
+            raise TypeError("not a voice provider entry point")
+        args, kwargs = self.runtime._decode_args(params)
+        validate_input(args, kwargs)
+        with self.lock:
+            if owner in self.retired_owners or self.runtime.refs.get(owner) is not obj:
+                raise RuntimeError("voice provider has been released")
+            if time.monotonic() >= params["deadline"]:
+                raise TimeoutError("voice opening deadline expired")
+            if token in self.entries or len(self.entries) >= MAX_SESSIONS:
+                raise ValueError("voice session capacity exceeded or duplicate token")
+            entry = _Entry(owner, self.runtime.owners.get(owner), kind)
+            self.entries[token] = entry
+        try:
+            value = self.runtime._run(getattr(obj, method)(*args, **kwargs))
+            entry.value = value
+            valid = isinstance(value, TranscriptionStreamSession) if kind == "asr" else isinstance(value, Iterator)
+            if not valid:
+                raise TypeError("voice provider returned an invalid session type")
+            with self.lock:
+                if entry.closed or self.runtime.refs.get(owner) is not obj:
+                    raise RuntimeError("voice session closed while opening")
+            return {"kind": kind, "token": token}
+        except BaseException:
+            entry.closed = True
+            raise
+        finally:
+            self._finish(token, entry)
+
+    def _finish(self, token, entry):
+        with self.lock:
+            entry.busy = False
+            cleanup = entry.closed
+            if cleanup:
+                # Cleanup may block too; keep its slot, but never hold the pipe caller.
+                entry.busy = True
+        if cleanup:
+            threading.Thread(target=contextvars.copy_context().run,
+                             args=(self._cleanup, token, entry), daemon=True,
+                             name="plugin-voice-cleanup").start()
+
+    def _cleanup(self, token, entry):
+        try:
+            close = getattr(entry.value, "close", None)
+            if callable(close):
+                close()
+        except Exception:
+            logger.warning("Voice session cleanup failed", exc_info=True)
+        finally:
+            with self.lock:
+                self.entries.pop(token, None)
+
+    def close(self, params):
+        token = str(params["token"])
+        with self.lock:
+            entry = self.entries.get(token)
+            if entry is None:
+                return
+            if entry.owner != int(params["ref"]):
+                raise PermissionError("voice session owner mismatch")
+            entry.closed = True
+            idle = not entry.busy
+            if idle:
+                entry.busy = True
+        if idle:
+            self._finish(token, entry)
+
+    def release(self, params):
+        for handle in params["handles"]:
+            self.close(handle)
+
+    def close_owner(self, owner=None, plugin=None):
+        with self.lock:
+            with self.runtime._lock:
+                refs = [ref for ref, key in self.runtime.owners.items()
+                        if (owner is None or ref == owner) and (plugin is None or key == plugin)]
+            self.retired_owners.update(refs)
+            idle = []
+            for token, entry in self.entries.items():
+                if (owner is None or owner == entry.owner) and (plugin is None or plugin == entry.plugin):
+                    entry.closed = True
+                    if not entry.busy:
+                        entry.busy = True
+                        idle.append((token, entry))
+        for token, entry in idle:
+            self._finish(token, entry)
+
+    def reap_owners(self):
+        with self.lock:
+            with self.runtime._lock:
+                self.retired_owners.intersection_update(self.runtime.refs)
+
+    def operation(self, params):
+        token, action = str(params["token"]), str(params["action"])
+        with self.lock:
+            entry = self.entries.get(token)
+            if entry is None or entry.closed:
+                raise RuntimeError("voice session is closed")
+            if entry.owner != int(params["ref"]) or self.runtime.owners.get(entry.owner) != entry.plugin:
+                raise PermissionError("voice session owner mismatch")
+            if entry.busy:
+                raise RuntimeError("voice session operation already in flight")
+            entry.busy = True
+        try:
+            result, terminal = self._operate(entry, action, params)
+            with self.lock:
+                if entry.closed:
+                    raise RuntimeError("voice session closed during operation")
+                entry.closed = terminal
+            return encode(result)
+        except BaseException:
+            entry.closed = True
+            raise
+        finally:
+            self._finish(token, entry)
+
+    def _operate(self, entry, action, params):
+        if entry.kind == "tts" and action == "next":
+            try:
+                chunk = next(entry.value)
+            except StopIteration:
+                return {"end": True}, True
+            self._audio(entry, chunk)
+            return {"chunk": chunk}, False
+        if entry.kind == "asr" and action == "push":
+            chunk = decode(params.get("chunk"))
+            self._audio(entry, chunk)
+            entry.value.push_audio(chunk)
+            return None, False
+        if entry.kind == "asr" and action == "partial":
+            return bounded_text(entry.value.partial_transcript()), False
+        if entry.kind == "asr" and action == "finalize":
+            result = entry.value.finalize()
+            if not isinstance(result, dict) or type(result.get("success")) is not bool:
+                raise TypeError("invalid transcription envelope")
+            output = {"success": result["success"], "transcript": bounded_text(result.get("transcript")),
+                      "provider": bounded_text(result.get("provider"))}
+            if not output["success"]:
+                output["error"] = bounded_text(result.get("error"))
+            return output, True
+        raise ValueError("invalid typed voice operation")
+
+    @staticmethod
+    def _audio(entry, chunk):
+        if not isinstance(chunk, bytes) or len(chunk) > MAX_CHUNK:
+            raise ValueError("voice chunk must be bytes of at most 1 MiB")
+        entry.total += len(chunk)
+        if entry.total > MAX_AUDIO:
+            raise ValueError("voice session audio exceeds 32 MiB")
+
+
+def _abandon(host, generation, ref, token):
+    # GC must never block on IPC. The next host call flushes the release queue.
+    host._queue_voice_release(generation, {"ref": ref, "token": token})
+
+
+class _RemoteVoice:
+    def __init__(self, host, ref, generation, token):
+        self.host, self.ref, self.generation, self.token = host, ref, generation, token
+        self.closed = threading.Event()
+        self.lock = threading.Lock()
+        self.finalizer = weakref.finalize(self, _abandon, host, generation, ref, token)
+
+    def _call(self, action, **extra):
+        if self.closed.is_set():
+            raise RuntimeError("voice session is closed")
+        if not self.lock.acquire(blocking=False):
+            raise RuntimeError("voice session operation already in flight")
+        try:
+            result = self.host._call("voice_op", {"ref": self.ref, "token": self.token,
+                "action": action, **extra}, generation=self.generation, timeout=CALL_TIMEOUT)
+            if self.closed.is_set():
+                raise RuntimeError("voice session closed during operation")
+            return result
+        except BaseException:
+            self.close()
+            raise
+        finally:
+            self.lock.release()
+
+    def close(self):
+        if self.closed.is_set():
+            return
+        self.closed.set()
+        self.finalizer.detach()
+        try:
+            self.host._call("voice_close", {"ref": self.ref, "token": self.token},
+                            generation=self.generation, timeout=CLOSE_TIMEOUT)
+            self.host._forget_voice_token(self.generation, self.token)
+        except Exception:  # health: allow BLE001 -- cleanup must not mask an in-flight failure; retain the handle for bounded retry without logging provider data
+            _abandon(self.host, self.generation, self.ref, self.token)
+
+    cancel = close
+
+
+class HostedTranscriptionSession(_RemoteVoice, TranscriptionStreamSession):
+    def push_audio(self, chunk):
+        if not isinstance(chunk, bytes) or len(chunk) > MAX_CHUNK:
+            self.close()
+            raise ValueError("voice chunk must be bytes of at most 1 MiB")
+        self._call("push", chunk=encode(chunk))
+
+    def partial_transcript(self):
+        return self._call("partial")
+
+    def finalize(self):
+        try:
+            return self._call("finalize")
+        except Exception as exc:  # health: allow BLE001 -- TranscriptionStreamSession.finalize must return a failure envelope for arbitrary provider/transport errors, not raise
+            return {"success": False, "transcript": "", "provider": "plugin-host", "error": str(exc)}
+        finally:
+            self.close()
+
+
+class HostedTTSIterator(_RemoteVoice, Iterator):
+    def __next__(self):
+        if self.closed.is_set():
+            raise StopIteration
+        result = self._call("next")
+        if result.get("end"):
+            self.close()
+            raise StopIteration
+        return result["chunk"]
+
+
+def open_voice(host, slot, method, args, kwargs, kind):
+    validate_input(args, kwargs)
+    ref, generation = slot.live()
+    token = uuid.uuid4().hex
+    host._reserve_voice_token(generation, token)
+    cls = HostedTranscriptionSession if kind == "asr" else HostedTTSIterator
+    proxy = cls(host, ref, generation, token)
+    try:
+        result = host._call("voice_open", {"ref": ref, "token": token, "method": method,
+            "args": encode(list(args)), "kwargs": encode(kwargs), "deadline": time.monotonic() + CALL_TIMEOUT},
+            generation=generation, timeout=CALL_TIMEOUT)
+        if result != {"kind": kind, "token": token}:
+            raise TypeError("invalid typed voice open response")
+        return proxy
+    except BaseException:
+        proxy.close()
+        raise
