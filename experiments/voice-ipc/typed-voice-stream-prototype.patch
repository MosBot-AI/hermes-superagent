+def test_gc_release_retry_preserves_pending_cleanup(providers, monkeypatch):
+    import gc
+    _, _, tts = providers
+    chunks = tts.stream("release")
+    assert next(chunks) == b"release"
+    host = chunks.host
+    channel = host._channel
+    original = channel.call
+    fail = [True]
+    def call(method, params, **kwargs):
+        if method == "voice_release" and fail[0]:
+            fail[0] = False
+            raise TimeoutError("synthetic missing close acknowledgement")
+        return original(method, params, **kwargs)
