@@ -0,0 +1,352 @@
+"""Native voice consumers over host pipes with deterministic, non-speech PCM fixtures.
+
+These tests prove dispatch, profile scope, streaming and cleanup, not speech quality.
+No microphone, speaker, credentials, model download, gateway or socket listener is used.
+"""
+
+from contextlib import contextmanager
+import json
+import os
+from pathlib import Path
+import threading
+
+import pytest
+
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+PLUGIN_ID = "native-voice-fixture"
+NAME = "synthetic-native-voice"
+PCM = b"\x00\x00\x01\x00"
+
+PLUGIN = r'''
+import json
+import os
+import threading
+import time
+from pathlib import Path
+from agent.transcription_provider import TranscriptionProvider, TranscriptionStreamSession
+from agent.tts_provider import TTSProvider
+
+HOME = Path(__file__).parent.parent.parent
+LABEL = HOME.name
+LOG = HOME / "voice-events.jsonl"
+
+def record(event, **values):
+    with LOG.open("a", encoding="utf-8") as out:
+        out.write(json.dumps(dict(event=event, pid=os.getpid(), profile=LABEL, **values)) + "\n")
+
+class Utterance(TranscriptionStreamSession):
+    def __init__(self, language, prompt):
+        self.audio = bytearray()
+        self.prompt = prompt
+        record("asr-open", language=language, prompt=prompt)
+    def push_audio(self, chunk):
+        if self.prompt == "blocked-push":
+            record("asr-blocked")
+            deadline = time.monotonic() + 10
+            while not (HOME / "release-push").exists():
+                if time.monotonic() > deadline:
+                    raise TimeoutError("test did not release blocked provider")
+                threading.Event().wait(0.01)
+        if self.prompt == "fail-push":
+            raise ValueError("synthetic push failure")
+        self.audio.extend(chunk)
+        record("asr-push", pcm=chunk.hex())
+    def partial_transcript(self):
+        return LABEL + " partial" if self.audio else ""
+    def finalize(self):
+        record("asr-final", pcm=self.audio.hex())
+        return dict(success=True, transcript=LABEL + " final", provider="synthetic-native-voice",
+                    pcm=self.audio.hex(), pid=os.getpid(), profile=LABEL)
+    def close(self):
+        record("asr-close")
+    def cancel(self):
+        self.close()
+
+class ASR(TranscriptionProvider):
+    name = "synthetic-native-voice"
+    streaming_capable = True
+    def is_available(self):
+        return True
