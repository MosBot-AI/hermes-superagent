+    _home_with_plugins(tmp_path, monkeypatch, {"voiceprobe": PLUGIN})
+    manager = PluginManager()
+    manager.discover_and_load()
+    assert manager._plugins["voiceprobe"].error is None
+    yield manager, transcription_registry.get_provider("voiceprobe"), tts_registry.get_provider("voiceprobe")
+    manager.unload()
+    manager._plugin_host().shutdown()
+
