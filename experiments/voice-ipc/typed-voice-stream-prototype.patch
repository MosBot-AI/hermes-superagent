+@pytest.mark.parametrize("termination", ["close", "timeout"])
+def test_busy_close_fences_late_output_and_retains_capacity(providers, monkeypatch, termination):
+    from hermes_cli import plugin_host_voice as voice
+    _, asr, tts = providers
+    chunks = tts.stream("block")
+    sessions = [asr.open_stream_session() for _ in range(voice.MAX_SESSIONS - 1)]
+    if termination == "timeout": monkeypatch.setattr(voice, "CALL_TIMEOUT", 2.0)
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        pending = pool.submit(next, chunks)
+        assert wait_until(lambda: tts.counts()["started"], timeout=5)
+        if termination == "close":
+            chunks.close()
+        else:
+            with pytest.raises(TimeoutError): pending.result(timeout=5)
+        # Closed logical handles still occupy a slot while provider compute runs.
+        with pytest.raises(ValueError): asr.open_stream_session()
+        tts.unblock()
+        if termination == "close":
+            with pytest.raises(RuntimeError): pending.result(timeout=5)
+        assert wait_until(lambda: tts.counts()["closed"] == 1, timeout=5)
+    with pytest.raises(StopIteration): next(chunks)
+    replacement = asr.open_stream_session()
+    replacement.close()
+    for session in sessions: session.close()
+
