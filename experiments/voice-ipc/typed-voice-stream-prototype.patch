+"""Typed voice handles use real host pipes, with bounded and terminal semantics."""
+import pytest
+from concurrent.futures import ThreadPoolExecutor
+from tests.waiting import wait_until
+
+from tests.hermes_cli.test_plugin_host import _home_with_plugins
+from hermes_cli.plugins import PluginManager
+from hermes_cli.plugin_host_wire import Opaque
+from agent.transcription_provider import TranscriptionStreamSession
+
+PLUGIN = '''
+from agent.transcription_provider import TranscriptionProvider, TranscriptionStreamSession
+from agent.tts_provider import TTSProvider
+import threading
+_OPEN_GATE = threading.Event()
+_OPEN_STARTED = threading.Event()
+_CLOSE_GATE = threading.Event()
+_CLOSE_STARTED = threading.Event()
+_CLOSED = 0
+class Session(TranscriptionStreamSession):
+    def __init__(self, block_close=False): self.audio, self.block_close = b"", block_close
+    def close(self):
+        global _CLOSED
+        if self.block_close:
+            _CLOSE_STARTED.set()
+            if not _CLOSE_GATE.wait(20): raise TimeoutError("close test gate expired")
+        _CLOSED += 1
+    def push_audio(self, chunk): self.audio += chunk
+    def partial_transcript(self): return str(len(self.audio))
+    def finalize(self): return {"success": True, "transcript": self.audio.decode(), "provider": "voiceprobe"}
+class ASR(TranscriptionProvider):
+    name = "voiceprobe"
+    streaming_capable = True
+    def transcribe(self, file_path, **kwargs): return {"success": True, "transcript": file_path, "provider": self.name}
+    def open_stream_session(self, **kwargs):
+        if kwargs.get("prompt") == "bad": return object()
+        if kwargs.get("prompt") == "block":
+            _OPEN_STARTED.set()
+            if not _OPEN_GATE.wait(20): raise TimeoutError("open test gate expired")
+        return Session(kwargs.get("prompt") == "cleanup")
+    def unrelated(self): return Session()
+    def unrelated_iterator(self): return iter([b"not a voice result"])
+class TTS(TTSProvider):
+    name = "voiceprobe"
+    def __init__(self):
+        self._gate = threading.Event()
+        self._started = threading.Event()
+        self._closed = 0
+        self._pulls = 0
+    def counts(self): return {"started": self._started.is_set(), "closed": self._closed, "pulls": self._pulls}
+    def unblock(self): self._gate.set()
+    def lifecycle(self): return {"open_started": _OPEN_STARTED.is_set(), "close_started": _CLOSE_STARTED.is_set(), "closed": _CLOSED}
+    def unblock_open(self): _OPEN_GATE.set()
+    def unblock_close(self): _CLOSE_GATE.set()
+    def synthesize(self, text, output_path, **kwargs): return output_path
+    def stream(self, text, **kwargs):
+        try:
+            self._pulls += 1
+            if text == "block":
+                self._started.set()
+                if not self._gate.wait(20): raise TimeoutError("test gate expired")
+            yield text.encode()
+            self._pulls += 1
+            if text == "error": raise ValueError("synthetic failure")
+            if text == "bad": yield "not bytes"
+            yield b"!"
+        finally:
+            self._closed += 1
+def register(ctx):
+    ctx.register_transcription_provider(ASR())
+    ctx.register_tts_provider(TTS())
+'''
+
+@pytest.fixture
+def providers(tmp_path, monkeypatch):
