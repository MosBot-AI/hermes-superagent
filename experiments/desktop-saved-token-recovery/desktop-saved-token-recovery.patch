+/** Only edits of the token used by a registry-owned URL primary retire its cached descriptor. */
+export function registryPrimaryTokenChanged(
+  input: DesktopRemoteRouteInput,
+  before: RegistryConnection,
+  after: RegistryConnection
+): boolean {
+  if (
+    before.kind !== 'remote' ||
+    after.kind !== 'remote' ||
+    normAuthMode(before.authMode) !== 'token' ||
+    normAuthMode(after.authMode) !== 'token' ||
+    before.url !== after.url ||
+    JSON.stringify(before.token ?? null) === JSON.stringify(after.token ?? null) ||
+    input.registry.primary !== before.id ||
+    String(input.env?.url || '').trim()
+  ) {
+    return false
+  }
+
+  const route = resolveDesktopRemoteRoute(input)
+
+  return route?.source === 'registry' && route.connectionId === before.id
+}
