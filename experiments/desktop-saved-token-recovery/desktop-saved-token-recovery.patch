+test('only an explicit token replacement at the same registry primary URL recycles the primary', () => {
+  const sources = registry('primary', [
+    { id: 'primary', kind: 'remote', label: 'Primary', url: 'https://gateway.test', token: tokenA },
+    { id: 'peer', kind: 'remote', label: 'Peer', url: 'https://peer.test', token: tokenA }
+  ])
+  const primary = sources.connections.find(c => c.id === 'primary')!
+  const peer = sources.connections.find(c => c.id === 'peer')!
+  const input = { registry: sources, config: { mode: 'local' }, profile: 'worker' }
+  const replacement = { ...primary, token: tokenB }
+
+  assert.equal(registryPrimaryTokenChanged(input, primary, replacement), true)
+  assert.equal(registryPrimaryTokenChanged(input, primary, { ...primary, label: 'Renamed' }), false)
+  assert.equal(registryPrimaryTokenChanged(input, peer, { ...peer, token: tokenB }), false)
+  assert.equal(registryPrimaryTokenChanged(input, primary, { ...replacement, url: 'https://new.test' }), false)
+  assert.equal(registryPrimaryTokenChanged(input, primary, { ...replacement, authMode: 'oauth' }), false)
+  assert.equal(
+    registryPrimaryTokenChanged({ ...input, env: { url: 'https://gateway.test' } }, primary, replacement),
+    false
+  )
+  const override = { mode: 'remote', url: primary.url, authMode: 'token', token: tokenA }
+  assert.equal(
+    registryPrimaryTokenChanged({ ...input, config: { mode: 'remote', remote: override } }, primary, replacement),
+    false
+  )
+  assert.equal(
+    registryPrimaryTokenChanged(
+      { ...input, config: { mode: 'local', profiles: { worker: override } } },
+      primary,
+      replacement
+    ),
+    false
+  )
+})
